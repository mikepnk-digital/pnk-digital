---
// One audited business on /audit: name, type, location and a small score
// ring; the whole card links to its report.
import Icon from '../landing/Icon.astro';
import ScoreRing from './ScoreRing.astro';
import type { Prospect } from '@/data/prospects';

export interface Props {
  prospect: Prospect;
}
const { prospect } = Astro.props;
---
<a class="card" href={`/audit/${prospect.slug}`}>
  <span class="text">
    <h3>{prospect.name}</h3>
    <span class="type">{prospect.type}</span>
    <span class="loc"><Icon name="map-pin" size={14} />{prospect.location}</span>
    <span class="more">View Audit <Icon name="arrow" size={16} /></span>
  </span>
  <ScoreRing score={prospect.overallScore} size="sm" />
</a>

<style>
  .card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    background: var(--lp-white);
    color: var(--lp-ink);
    text-decoration: none;
    transition: border-color 0.3s ease;
  }
  .card:hover {
    color: var(--lp-ink);
    border-color: var(--lp-border-strong);
  }
  .text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  h3 {
    font-size: var(--lp-text-md);
    font-weight: 800;
    line-height: 1.3;
  }
  .card:hover h3 {
    color: var(--lp-pink-text);
  }
  .type {
    font-size: var(--lp-text-sm);
    color: var(--lp-muted);
  }
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    font-size: var(--lp-text-xs);
    color: var(--lp-muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: var(--lp-text-sm);
    font-weight: 700;
    color: var(--lp-pink-text);
  }
</style>
