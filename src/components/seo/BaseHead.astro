---
// Site-wide <head>: HeadMeta (favicons, manifest, gtag, SEO meta) + the main
// site theme (global CSS and Inter). Used by Layout.astro, BareLayout.astro and
// directly by layout-less pages (landing, audit).
import '../../index.css';
import HeadMeta from './HeadMeta.astro';
import type { Props as HeadMetaProps } from './HeadMeta.astro';

export type Props = HeadMetaProps;
---
<HeadMeta {...Astro.props} />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
