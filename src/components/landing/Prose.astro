---
// Long-form text from markdown (blog posts, case-study bodies, legal pages):
// landing type scale and colours for whatever elements the content uses.
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 720px;
    font-size: var(--lp-text-base);
    line-height: 1.75;
    color: var(--lp-muted);
  }
  .prose :global(:where(p, ul, ol, blockquote, pre, table, figure)) {
    margin: 0 0 1.4em;
  }
  .prose :global(:where(h2, h3, h4)) {
    color: var(--lp-ink);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .prose :global(h2) {
    margin: 1.9em 0 0.6em;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.2;
  }
  .prose :global(h3) {
    margin: 1.6em 0 0.5em;
    font-size: var(--lp-h3);
    line-height: 1.3;
  }
  .prose :global(h4) {
    margin: 1.4em 0 0.4em;
    font-size: var(--lp-text-md);
  }
  .prose :global(:where(h2, h3, h4):first-child) {
    margin-top: 0;
  }
  .prose :global(strong) {
    color: var(--lp-ink);
    font-weight: 700;
  }
  .prose :global(a) {
    color: var(--lp-pink-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--lp-dark);
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.4em;
  }
  .prose :global(li + li) {
    margin-top: 0.45em;
  }
  .prose :global(li::marker) {
    color: var(--lp-pink-text);
  }
  .prose :global(blockquote) {
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--lp-pink);
    font-style: italic;
    color: var(--lp-ink);
  }
  .prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--lp-surface-2);
    color: var(--lp-pink-text);
    font-size: 0.9em;
  }
  .prose :global(pre) {
    padding: 18px 20px;
    border-radius: var(--lp-radius-inner);
    overflow-x: auto;
    font-size: var(--lp-text-sm);
    line-height: 1.6;
  }
  .prose :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--lp-border);
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--lp-text-sm);
  }
  .prose :global(:where(th, td)) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--lp-border);
    text-align: left;
  }
  .prose :global(th) {
    color: var(--lp-ink);
    font-weight: 700;
  }
</style>
