---
// Version A hero: founder voice, photo card of Mike.
import Icon from './Icon.astro';
import LandingPhoto from './LandingPhoto.astro';
import { CALL_LABEL, YEARS_EXPERIENCE } from '@/config/site';

const trust = [`${YEARS_EXPERIENCE} years in financial services tech`, 'No call centres', "Cancel with 30 days' notice"];
const cardPoints = ['Website, email and security in one place', 'An update on every request', 'Fixed monthly fee, from £125'];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="inner">
    <div class="copy">
      <span class="eyebrow"><span class="dot" aria-hidden="true"></span>Tech Support Plans</span>
      <h1 id="hero-title">Your outsourced tech team, for a fixed monthly fee</h1>
      <p class="sub">
        One person who looks after your website, email, Microsoft 365 or Google Workspace, and security – and fixes things properly.
      </p>
      <div class="ctas">
        <a class="lp-btn lp-btn--pink cta" href="#book" data-book>{CALL_LABEL}</a>
        <a class="see" href="#plans" data-scroll>See plans</a>
      </div>
      <ul class="trust">
        {trust.map((t) => <li><Icon name="check" size={16} />{t}</li>)}
      </ul>
    </div>
    <div class="card">
      <div class="photo">
        <LandingPhoto
          photo="mike-hero"
          alt="Mike, founder of PNK Digital"
          widths={[400, 800]}
          sizes="(min-width: 760px) 412px, calc(100vw - 68px)"
          loading="eager"
        />
      </div>
      <div class="body">
        <p class="hi">PNK Digital is run by Mike Pink, your tech person.</p>
        <p class="line">I answer, I fix it, and I tell you what happened in plain English.</p>
        <ul class="points">
          {cardPoints.map((p) => <li><Icon name="check" size={18} />{p}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--lp-surface);
    padding: clamp(40px, 7vw, 96px) var(--lp-section-x) clamp(48px, 7vw, 104px);
  }
  .inner {
    max-width: var(--lp-max);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(36px, 5vw, 72px);
    align-items: flex-start;
  }
  .copy {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lp-pink-text);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lp-pink);
  }
  h1 {
    font-size: var(--lp-h1);
    line-height: var(--lp-h1-lh);
    letter-spacing: -0.035em;
    font-weight: 800;
  }
  .sub {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
    color: var(--lp-muted);
    max-width: 560px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    align-items: center;
  }
  .cta {
    padding: 16px 30px;
    min-height: 58px;
  }
  .see {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--lp-dark);
    text-decoration: underline;
    text-decoration-color: var(--lp-pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
    border-radius: 4px;
  }
  .see:hover {
    color: var(--lp-pink-text);
  }
  .see:focus-visible {
    outline: 3px solid var(--lp-dark);
    outline-offset: 3px;
  }
  .trust {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 15px;
    font-weight: 600;
    color: var(--lp-muted);
  }
  .trust li,
  .points li {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .trust :global(svg),
  .points :global(svg) {
    flex: none;
    color: var(--lp-pink-text);
  }
  .card {
    flex: 1 1 320px;
    max-width: 440px;
    min-width: 0;
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-panel);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: var(--lp-hero-shadow);
  }
  .photo {
    height: 410px;
    border-radius: 18px;
    overflow: hidden;
  }
  .body {
    padding: 0 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hi {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .line {
    font-size: 16px;
    line-height: 1.55;
    color: var(--lp-muted);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
  }
  .points li {
    gap: 10px;
  }
</style>
