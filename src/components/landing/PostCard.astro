---
// Blog post card (home "Latest Thinking", /blog, related posts): category,
// title, excerpt, date and reading time. The whole card links to the post.
import Icon from './Icon.astro';
import { calculateReadingTime, formatDate, type Post } from '@/lib/posts';

export interface Props {
  post: Post;
  /** Heading level for the title (h3 under a section h2). */
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const Title = `h${headingLevel}` as 'h2' | 'h3';
---
<a class="post" href={`/blog/${post.id}`}>
  <span class="category">{post.data.category}</span>
  <Title class="title">{post.data.title}</Title>
  <p class="excerpt">{post.data.excerpt}</p>
  <span class="meta">
    <span><Icon name="calendar" size={14} /><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time></span>
    <span><Icon name="clock" size={14} />{calculateReadingTime(post.body ?? '')}</span>
  </span>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 28px;
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    color: var(--lp-ink);
    text-decoration: none;
    transition: border-color 0.3s ease;
  }
  .post:hover {
    color: var(--lp-ink);
    border-color: var(--lp-border-strong);
  }
  .post:hover .title {
    color: var(--lp-pink-text);
  }
  .category {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: var(--lp-radius-badge);
    background: var(--lp-pink-tint);
    color: var(--lp-pink-text);
    font-size: var(--lp-text-xs);
    font-weight: 700;
  }
  .title {
    font-size: var(--lp-h3);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
    transition: color 0.15s ease;
  }
  .excerpt {
    flex: 1;
    font-size: var(--lp-text-base);
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: var(--lp-text-sm);
    color: var(--lp-muted);
  }
  .meta > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
</style>
