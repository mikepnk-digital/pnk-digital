---
// Plan comparison. ≥760px: a real <table> with the highlighted plan's column
// tinted. <760px: a segmented control (aria-pressed) showing one plan at a
// time. Without JS the control is hidden and all three plan lists stack.
import Icon from './Icon.astro';
import { planPriceLabel } from '@/data/tech-support';
import type { CompareGroup, CompareValue, Plan, PlanId } from '@/data/tech-support';

export interface Props {
  plans: Plan[];
  groups: CompareGroup[];
  highlight: PlanId;
}
const { plans, groups, highlight } = Astro.props;
const hl = Math.max(0, plans.findIndex((p) => p.id === highlight));
const textOf = (v: CompareValue) => (typeof v === 'string' ? v : v ? 'Included' : 'Not included');
---
<div class="compare" data-compare>
  <!-- Desktop -->
  <div class="wide">
    <table>
      <caption class="lp-sr-only">Compare plans</caption>
      <colgroup>
        <col class="col-label" />
        {plans.map(() => <col class="col-plan" />)}
      </colgroup>
      <thead>
        <tr>
          <th scope="col" class="corner">What's included</th>
          {
            plans.map((p, i) => (
              <th scope="col" class:list={['plan-head', { hl: i === hl }]}>
                <span class="plan-name">{p.name}</span>
                <span class="plan-price">{planPriceLabel(p)}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      {
        groups.map((g) => (
          <tbody>
            <tr class="group">
              <th scope="rowgroup" colspan={plans.length + 1}>{g.title}</th>
            </tr>
            {g.rows.map((r) => (
              <tr>
                <th scope="row" class="label">{r.label}</th>
                {r.v.map((v, i) => (
                  <td class:list={{ hl: i === hl }}>
                    {v === true ? (
                      <>
                        <Icon name="check" size={20} class="yes" />
                        <span class="lp-sr-only">Included</span>
                      </>
                    ) : v === false ? (
                      <>
                        <span aria-hidden="true" class="no">—</span>
                        <span class="lp-sr-only">Not included</span>
                      </>
                    ) : (
                      v
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </div>

  <!-- Mobile -->
  <div class="narrow">
    <div class="tabs" role="group" aria-label="Choose a plan to compare">
      {
        plans.map((p, i) => (
          <button type="button" class="tab" aria-pressed={i === hl ? 'true' : 'false'} aria-controls={`compare-${p.id}`} data-tab={i}>
            {p.name}
          </button>
        ))
      }
    </div>
    {
      plans.map((p, i) => (
        <div class="panel" id={`compare-${p.id}`} data-panel={i} data-default={i === hl ? '' : undefined}>
          <div class="panel-head">
            <h3 class="panel-name">{p.name}</h3>
            <span class="panel-price">{planPriceLabel(p)}</span>
          </div>
          {groups.map((g) => (
            <>
              <div class="panel-group">{g.title}</div>
              <dl>
                {g.rows.map((r) => (
                  <div class="panel-row">
                    <dt>{r.label}</dt>
                    <dd class:list={{ off: r.v[i] === false }}>
                      {r.v[i] === true && <Icon name="check" size={18} class="yes" />}
                      {textOf(r.v[i])}
                    </dd>
                  </div>
                ))}
              </dl>
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  // Mobile tabs: show one plan panel at a time (enhancement; without JS all panels show).
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const select = (index: number) => {
      tabs.forEach((t, i) => t.setAttribute('aria-pressed', String(i === index)));
      panels.forEach((p, i) => (p.hidden = i !== index));
    };
    const initial = panels.findIndex((p) => p.hasAttribute('data-default'));
    select(initial < 0 ? 0 : initial);
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
  });
</script>

<style>
  .wide {
    display: none;
  }
  .narrow {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (min-width: 760px) {
    .wide {
      display: block;
    }
    .narrow {
      display: none;
    }
  }

  /* Desktop table */
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    border: 1px solid var(--lp-border);
    border-radius: 20px;
    overflow: hidden;
    background: var(--lp-white);
  }
  .col-label {
    width: 36.17%;
  }
  .col-plan {
    width: 21.28%;
  }
  th,
  td {
    font-weight: inherit;
    text-align: left;
  }
  thead th {
    border-bottom: 1px solid var(--lp-border);
  }
  .corner {
    padding: 22px 24px;
    font-size: 15px;
    font-weight: 700;
    color: var(--lp-muted);
    vertical-align: bottom;
  }
  .plan-head {
    padding: 22px 16px;
    text-align: center;
  }
  .plan-name {
    display: block;
    font-size: 19px;
    font-weight: 800;
  }
  .plan-price {
    display: block;
    margin-top: 2px;
    font-size: 15px;
    font-weight: 600;
    color: var(--lp-muted);
  }
  .group th {
    padding: 12px 24px;
    background: var(--lp-surface);
    border-top: 1px solid var(--lp-header-border);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lp-muted);
  }
  thead + tbody .group th {
    border-top: 0;
  }
  .label {
    padding: 15px 24px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    border-top: 1px solid var(--lp-rule);
  }
  td {
    padding: 15px 14px;
    text-align: center;
    vertical-align: middle;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    border-top: 1px solid var(--lp-rule);
  }
  td :global(.yes) {
    margin: 0 auto;
  }
  .hl {
    background: var(--lp-pink-tint);
  }
  .no {
    color: var(--lp-input-border);
  }
  .compare :global(.yes) {
    color: var(--lp-pink-text);
  }

  /* Mobile tabs + panels */
  .tabs {
    display: none;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    padding: 6px;
    background: var(--lp-surface-2);
    border-radius: var(--lp-radius-btn);
  }
  :global(.lp-js) .tabs {
    display: grid;
  }
  .tab {
    appearance: none;
    border: 0;
    cursor: pointer;
    min-height: 48px;
    border-radius: var(--lp-radius-btn);
    background: transparent;
    color: var(--lp-dark);
    font-size: 16px;
    font-weight: 700;
  }
  .tab[aria-pressed='true'] {
    background: var(--lp-dark);
    color: var(--lp-white);
  }
  .tab:focus-visible {
    outline: 3px solid var(--lp-pink);
    outline-offset: 2px;
  }
  .panel {
    border: 1px solid var(--lp-border);
    border-radius: 20px;
    background: var(--lp-white);
    overflow: hidden;
  }
  .panel[hidden] {
    display: none;
  }
  .panel-head {
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .panel-name {
    margin: 0;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 800;
  }
  .panel-price {
    font-size: 16px;
    font-weight: 700;
    color: var(--lp-muted);
  }
  .panel-group {
    padding: 10px 20px;
    background: var(--lp-surface);
    border-top: 1px solid var(--lp-header-border);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lp-muted);
  }
  .panel-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-top: 1px solid var(--lp-rule);
  }
  dt {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }
  dd {
    flex: none;
    max-width: 46%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    text-align: right;
    font-size: 15px;
    font-weight: 700;
  }
  dd.off {
    color: var(--lp-subtle);
    font-weight: 600;
  }
</style>
