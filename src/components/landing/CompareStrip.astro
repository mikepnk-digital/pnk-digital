---
// "How it compares": row labels down the side, one column per option, the
// highlighted column tinted pink. ≥760px: a real <table>. <760px: one stacked
// card per option instead (CSS swap, no JS; display:none keeps the hidden copy
// out of the accessibility tree). `stack={false}` keeps a small table as a
// compact table at every width.
import type { CompareColumn, CompareRow } from '@/data/ai-consulting';

export interface Props {
  caption: string;
  columns: CompareColumn[];
  rows: CompareRow[];
  /** Small source line under the table. */
  source?: string;
  /** Level of the stacked card titles: 4 when the strip sits under an h3. */
  headingLevel?: 3 | 4;
  /** Swap to stacked cards under 760px. Turn off for tables that fit narrow. */
  stack?: boolean;
}
const { caption, columns, rows, source, headingLevel = 3, stack = true } = Astro.props;
const CardHeading = headingLevel === 4 ? 'h4' : 'h3';
---
<div class:list={['compare', { 'no-stack': !stack }]} data-reveal>
  <table>
    <caption class="lp-sr-only">{caption}</caption>
    <thead>
      <tr>
        <td class="corner"></td>
        {columns.map((c) => <th scope="col" class:list={{ hl: c.highlight }}>{c.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {r.values.map((v, i) => (
              <td class:list={{ hl: columns[i]?.highlight }}>{v}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>

  <!-- Narrow screens: one card per option. -->
  {stack && (
    <ul class="cards">
      {
        columns.map((c, ci) => (
          <li class:list={['card', { hl: c.highlight }]}>
            <CardHeading class="card-title">{c.label}</CardHeading>
            <dl>
              {rows.map((r) => (
                <div class="pair">
                  <dt>{r.label}</dt>
                  <dd>{r.values[ci]}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ul>
  )}
  {source && <p class="source">{source}</p>}
</div>

<style>
  .compare {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Wide: table */
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    overflow: hidden;
  }
  th,
  td {
    padding: 18px 20px;
    text-align: left;
    vertical-align: top;
    font-size: var(--lp-text-base);
    line-height: 1.5;
    border-bottom: 1px solid var(--lp-border);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: var(--lp-text-md);
    font-weight: 800;
    line-height: 1.3;
  }
  .corner {
    width: 22%;
  }
  tbody th {
    font-size: var(--lp-text-sm);
    font-weight: 800;
    color: var(--lp-ink);
  }
  td {
    color: var(--lp-muted);
  }
  .hl {
    background: var(--lp-pink-tint);
    color: var(--lp-ink);
    font-weight: 700;
  }
  thead th.hl {
    color: var(--lp-pink-text);
  }

  /* Narrow: stacked cards */
  .cards {
    display: none;
    flex-direction: column;
    gap: 16px;
  }
  .card {
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card.hl {
    border: 3px solid var(--lp-pink);
    font-weight: inherit;
    background: var(--lp-white);
  }
  .card-title {
    font-size: var(--lp-h3);
    font-weight: 800;
    line-height: 1.3;
  }
  .card.hl .card-title {
    color: var(--lp-pink-text);
  }
  dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pair {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  dt {
    font-size: var(--lp-text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lp-muted);
  }
  dd {
    margin: 0;
    font-size: var(--lp-text-base);
    line-height: 1.5;
    color: var(--lp-ink);
  }
  .card.hl dd {
    font-weight: 700;
  }

  @media (max-width: 759.98px) {
    .compare:not(.no-stack) table {
      display: none;
    }
    .compare:not(.no-stack) .cards {
      display: flex;
    }
    /* Compact table: let the columns size to their content. */
    .no-stack table {
      table-layout: auto;
    }
    .no-stack .corner {
      width: auto;
    }
    .no-stack th,
    .no-stack td {
      padding: 10px 6px;
      font-size: 14px;
    }
    .no-stack thead th {
      font-size: 15px;
    }
    .no-stack :is(th, td):first-child {
      padding-left: 12px;
    }
  }
  @media (max-width: 399.98px) {
    .no-stack th,
    .no-stack td,
    .no-stack thead th {
      font-size: 13px;
    }
    .no-stack th,
    .no-stack td {
      padding-inline: 4px;
    }
    .no-stack :is(th, td):first-child {
      padding-left: 10px;
    }
  }

  .source {
    font-size: var(--lp-text-sm);
    line-height: 1.5;
    color: var(--lp-muted);
  }
</style>
