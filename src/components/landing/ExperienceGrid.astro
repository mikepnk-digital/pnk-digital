---
// "Experience": a ruled grid of five disciplines, then a pink-ruled close.
import Icon from './Icon.astro';
import type { IconItem } from '@/data/tech-support-service';

export interface Props {
  items: IconItem[];
  close: string;
  /** Larger ink line under `close`. */
  closeStrong: string;
}
const { items, close, closeStrong } = Astro.props;
---
<ul class="exp">
  {
    items.map((e) => (
      <li>
        <span class="exp-icon"><Icon name={e.icon} size={24} /></span>
        <h3>{e.title}</h3>
        <p>{e.body}</p>
      </li>
    ))
  }
</ul>
<div class="exp-close">
  <p>{close}</p>
  <p class="exp-strong">{closeStrong}</p>
</div>

<style>
  /* 5 cards: 1, then 2 across with the last spanning the row, then 5 across
     from 1120px. The 1px gap shows the border colour, so an empty cell would
     render as a grey block (auto-fit gave 3+2 and 4+1). */
  .exp {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--lp-border);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    overflow: hidden;
  }
  .exp li {
    background: var(--lp-white);
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  @media (min-width: 600px) {
    .exp {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .exp li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1120px) {
    .exp {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .exp li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
  .exp-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--lp-surface);
    color: var(--lp-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .exp h3 {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.3;
  }
  .exp p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--lp-muted);
  }
  .exp-close {
    border-left: 4px solid var(--lp-pink);
    padding: 4px 0 4px clamp(18px, 3vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 820px;
  }
  .exp-close p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .exp-close .exp-strong {
    font-size: clamp(20px, 2.2vw, 25px);
    line-height: 1.35;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--lp-ink);
  }
</style>
