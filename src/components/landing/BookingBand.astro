---
// Pink booking band (#book): heading, intro and checks beside the BookingForm.
// A `copy` slot replaces the default copy column (it must contain the
// #book-title heading); `form` props are passed through to BookingForm.
// `calendar`: the copy spans the full width and the Cal.com calendar sits
// beside the form (calendar first when stacked). Without a CAL_LINK it falls
// back to the copy-beside-form layout.
import Icon from './Icon.astro';
import BookingForm from './BookingForm.astro';
import BookingEmbed from './BookingEmbed.astro';
import { CAL_LINK } from '@/config/site';
import type { Props as BookingFormProps } from './BookingForm.astro';
import type { Variant } from '@/data/tech-support';

export interface Props {
  variant: Variant;
  intro?: string;
  successLine: string;
  form?: Omit<BookingFormProps, 'variant' | 'successLine'>;
  calendar?: boolean;
}
const { variant, intro, successLine, form = {}, calendar = false } = Astro.props;
const withCalendar = calendar && !!CAL_LINK;
const checks = ['At a time that suits you', 'A plain-English summary afterwards', 'No obligation, no hard sell'];
---
<section id="book" class="band" aria-labelledby="book-title" data-booking-band>
  <div class:list={['inner', { 'with-calendar': withCalendar }]}>
    {
      Astro.slots.has('copy') ? (
        <div class="copy">
          <slot name="copy" />
        </div>
      ) : (
        <div class="copy">
          <h2 id="book-title">Find out what your tech really needs: free 30-minute review</h2>
          <p class="intro">{intro}</p>
          <ul class="checks">
            {checks.map((c) => <li><Icon name="check" size={22} />{c}</li>)}
          </ul>
        </div>
      )
    }
    {
      withCalendar && (
        <div class="card cal-card">
          <h3 class="card-title">Pick a time</h3>
          <BookingEmbed linkClass="lp-btn lp-btn--pink" />
        </div>
      )
    }
    <div class="card">
      {withCalendar && <h3 class="card-title">Or send us a message</h3>}
      <BookingForm variant={variant} successLine={successLine} {...form} />
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--lp-pink);
    padding: var(--lp-section-y) var(--lp-section-x);
  }
  .inner {
    max-width: var(--lp-max);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(36px, 5vw, 72px);
    align-items: flex-start;
  }
  /* White text on pink is large text only: headings or 20px bold (AA). */
  .copy {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    color: var(--lp-white);
  }
  h2 {
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .intro {
    font-size: 20px;
    line-height: 1.5;
    font-weight: 700;
  }
  .checks {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 20px;
    font-weight: 700;
  }
  .checks li {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .checks :global(svg) {
    flex: none;
  }
  .with-calendar .copy {
    flex-basis: 100%;
  }
  .card-title {
    margin-bottom: 16px;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--lp-ink);
  }
  .cal-card {
    padding-inline: clamp(12px, 2vw, 24px);
  }
  .cal-card .card-title {
    padding-inline: clamp(12px, 1.5vw, 16px);
  }
  .card {
    flex: 1 1 440px;
    min-width: 0;
    background: var(--lp-white);
    border-radius: 28px;
    padding: clamp(24px, 3.5vw, 40px);
    box-shadow: var(--lp-form-shadow);
  }
</style>
