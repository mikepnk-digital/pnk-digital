---
// Sticky landing header: logo, in-page section links (≥760px), phone link
// (icon only on phones) and the book-a-call button. Plain anchors, so it works without JS;
// Height is the --lp-header-h token (LandingLayout), which section links use
// via CSS scroll-padding-top and BookingForm uses for its scroll to #book.
import logo from '@/assets/pnk-digital-logo.svg';
import Icon from './Icon.astro';
import { CALL_LABEL, PHONE_DISPLAY, PHONE_HREF } from '@/config/site';

export interface Props {
  /** In-page section links (shown from 760px). */
  links?: { href: string; label: string }[];
  /** Book button label. */
  cta?: string;
}
const {
  links = [
    { href: '#plans', label: 'Plans' },
    { href: '#how', label: 'How it works' },
    { href: '#faq', label: 'FAQ' },
  ],
  cta = CALL_LABEL,
} = Astro.props;
---
<header class="header">
  <div class="inner">
    <a class="logo" href="/">
      <img src={logo.src} width="33" height="40" alt="" />
      <span>PNK Digital</span>
    </a>
    <nav aria-label="Page sections" class="nav">
      <ul class="links">
        {links.map((l) => <li><a href={l.href} data-scroll>{l.label}</a></li>)}
      </ul>
      <a class="phone" href={PHONE_HREF} data-phone aria-label={`Call ${PHONE_DISPLAY}`}>
        <Icon name="phone" size={18} /><span>{PHONE_DISPLAY}</span>
      </a>
      <a class="book" href="#book" data-book>{cta}</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    box-sizing: border-box;
    height: var(--lp-header-h);
    background: var(--lp-header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--lp-header-border);
  }
  .inner {
    max-width: var(--lp-header-max);
    margin: 0 auto;
    padding: 12px var(--lp-section-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }
  /* Mirrors the main site nav: mark + "PNK Digital", 12px gap. */
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
    color: var(--lp-dark);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
  }
  .logo:hover {
    color: var(--lp-dark);
  }
  .logo img {
    height: 40px;
    width: auto;
  }
  .logo:focus-visible {
    outline: 3px solid var(--lp-pink);
    outline-offset: 4px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 32px);
  }
  .links {
    display: none;
    gap: clamp(12px, 2.4vw, 32px);
  }
  @media (min-width: 900px) {
    .links {
      display: flex;
    }
  }
  .links a {
    display: inline-block;
    padding: 10px 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--lp-dark);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
  }
  .links a:hover {
    color: var(--lp-pink-text);
  }
  .phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    font-size: 16px;
    font-weight: 700;
    color: var(--lp-dark);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
  }
  .phone:hover {
    color: var(--lp-pink-text);
  }
  .phone span {
    display: none;
  }
  @media (min-width: 1100px) {
    .phone span {
      display: inline;
    }
  }
  .book {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 20px;
    border-radius: var(--lp-radius-header-btn);
    background: var(--lp-dark);
    color: var(--lp-white);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .book:hover {
    background: var(--lp-dark-hover);
    color: var(--lp-white);
  }
  .book:focus-visible {
    outline: 3px solid var(--lp-pink);
    outline-offset: 3px;
  }
  /* Phones: the longer call label needs the room, so show the mark only. */
  @media (max-width: 479.98px) {
    .logo span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  /* Small phones: keep mark + book button on one line, no overflow. */
  @media (max-width: 380px) {
    .inner {
      gap: 10px;
      padding-inline: 16px;
    }
    .logo {
      gap: 6px;
      font-size: 16px;
    }
    .logo img {
      height: 28px;
    }
    .book {
      padding: 10px 12px;
      font-size: 14px;
    }
  }
  @media (max-width: 340px) {
    .logo {
      font-size: 15px;
    }
    .logo img {
      height: 24px;
    }
  }
</style>
