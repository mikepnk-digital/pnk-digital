---
// Sticky header, in two modes, both plain anchors that work without JS.
// - Landing (default): logo, in-page section links (≥900px), phone link (icon
//   only on phones) and the book-a-call button. No main-site nav.
// - Site (`site`): logo, the main-site nav (≥1080px; a menu below that),
//   phone (number from 1320px) and the book-a-call button, which opens SiteLayout's Cal modal.
// Height is the --lp-header-h token (LandingLayout), which section links use
// via CSS scroll-padding-top and BookingForm uses for its scroll to #book.
import logo from '@/assets/pnk-digital-logo.svg';
import Icon from './Icon.astro';
import { CALL_LABEL, PHONE_DISPLAY, PHONE_HREF } from '@/config/site';

/** Main-site navigation (site mode). */
export const SITE_NAV = [
  { href: '/services', label: 'Services' },
  { href: '/tech-support', label: 'Tech Support' },
  { href: '/ai-consulting', label: 'AI Consulting' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];

export interface Props {
  /** In-page section links (landing mode, shown from 900px). */
  links?: { href: string; label: string }[];
  /** Book button label. */
  cta?: string;
  /** Site mode: main-site nav instead of section links. */
  site?: boolean;
  /** Current path, for the nav's active link (site mode). */
  currentPath?: string;
}
const {
  links = [
    { href: '#plans', label: 'Plans' },
    { href: '#how', label: 'How it works' },
    { href: '#faq', label: 'FAQ' },
  ],
  cta = CALL_LABEL,
  site = false,
  currentPath = '',
} = Astro.props;

const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---
<header class:list={['header', { 'header--site': site }]} data-lp-header>
  <div class="inner">
    <a class="logo" href="/">
      <img src={logo.src} width="33" height="40" alt="" />
      <span>PNK Digital</span>
    </a>
    {
      site ? (
        <nav aria-label="Main" class="nav">
          <ul class="links">
            {SITE_NAV.map((l) => (
              <li>
                <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
              </li>
            ))}
          </ul>
          <a class="phone" href={PHONE_HREF} data-phone aria-label={`Call ${PHONE_DISPLAY}`}>
            <Icon name="phone" size={18} /><span>{PHONE_DISPLAY}</span>
          </a>
          <a class="book" href="/contact" data-book>{cta}</a>
          <details class="menu" data-site-menu>
            <summary aria-label="Menu">
              <Icon name="menu" size={24} class="menu-open" />
              <Icon name="x" size={24} class="menu-close" />
            </summary>
            <div class="panel">
              <ul>
                {SITE_NAV.map((l) => (
                  <li>
                    <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
                  </li>
                ))}
                <li>
                  <a href={PHONE_HREF} data-phone class="panel-phone">
                    <Icon name="phone" size={18} />{PHONE_DISPLAY}
                  </a>
                </li>
              </ul>
            </div>
          </details>
        </nav>
      ) : (
        <nav aria-label="Page sections" class="nav">
          <ul class="links">
            {links.map((l) => <li><a href={l.href} data-scroll>{l.label}</a></li>)}
          </ul>
          <a class="phone" href={PHONE_HREF} data-phone aria-label={`Call ${PHONE_DISPLAY}`}>
            <Icon name="phone" size={18} /><span>{PHONE_DISPLAY}</span>
          </a>
          <a class="book" href="#book" data-book>{cta}</a>
        </nav>
      )
    }
  </div>
</header>

<script>
  // A soft shadow once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-lp-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Site menu: a <details> disclosure, so it opens without JS. With JS it also
  // closes on Escape, an outside click, or when the full nav takes over.
  const menu = document.querySelector<HTMLDetailsElement>('[data-site-menu]');
  if (menu) {
    const close = () => menu.removeAttribute('open');
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close();
    });
    matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && close());
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    box-sizing: border-box;
    height: var(--lp-header-h);
    background: var(--lp-header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--lp-header-border);
    transition: box-shadow 0.3s ease;
  }
  .header.is-scrolled {
    box-shadow: 0 10px 30px -18px rgba(31, 42, 55, 0.45);
  }
  .inner {
    max-width: var(--lp-header-max);
    margin: 0 auto;
    padding: 12px var(--lp-section-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }
  /* Mirrors the main site nav: mark + "PNK Digital", 12px gap. */
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
    color: var(--lp-dark);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
  }
  .logo:hover {
    color: var(--lp-dark);
  }
  .logo img {
    height: 40px;
    width: auto;
  }
  .logo:focus-visible {
    outline: 3px solid var(--lp-pink);
    outline-offset: 4px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 32px);
  }
  .links {
    display: none;
    gap: clamp(12px, 2.4vw, 32px);
  }
  @media (min-width: 900px) {
    .links {
      display: flex;
    }
  }
  .links a {
    display: inline-block;
    padding: 10px 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--lp-dark);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
  }
  .links a:hover {
    color: var(--lp-pink-text);
  }
  .phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    font-size: 16px;
    font-weight: 700;
    color: var(--lp-dark);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
  }
  .phone:hover {
    color: var(--lp-pink-text);
  }
  .phone span {
    display: none;
  }
  @media (min-width: 1100px) {
    .phone span {
      display: inline;
    }
  }
  .book {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 20px;
    border-radius: var(--lp-radius-header-btn);
    background: var(--lp-dark);
    color: var(--lp-white);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .book:hover {
    background: var(--lp-dark-hover);
    color: var(--lp-white);
  }
  .book:focus-visible {
    outline: 3px solid var(--lp-pink);
    outline-offset: 3px;
  }
  /* Phones: the longer call label needs the room, so show the mark only. */
  @media (max-width: 479.98px) {
    .logo span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  /* Small phones: keep mark + book button on one line, no overflow. */
  @media (max-width: 380px) {
    .inner {
      gap: 10px;
      padding-inline: 16px;
    }
    .logo {
      gap: 6px;
      font-size: 16px;
    }
    .logo img {
      height: 28px;
    }
    .book {
      padding: 10px 12px;
      font-size: 14px;
    }
  }
  @media (max-width: 340px) {
    .logo {
      font-size: 15px;
    }
    .logo img {
      height: 24px;
    }
  }
  /* ---- Site mode ---------------------------------------------------- */
  .header--site .links {
    display: none;
  }
  @media (min-width: 1080px) {
    .header--site .links {
      display: flex;
    }
    .header--site .menu {
      display: none;
    }
  }
  .header--site .links a[aria-current='page'] {
    color: var(--lp-pink-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  /* Five nav links leave room for the phone number only on wide screens. */
  @media (max-width: 1319.98px) {
    .header--site .phone span {
      display: none;
    }
  }
  /* The phone number moves into the menu on phones, so the book button fits. */
  @media (max-width: 479.98px) {
    .header--site .phone {
      display: none;
    }
  }
  .menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    color: var(--lp-dark);
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary:hover {
    background: var(--lp-surface-2);
  }
  .menu summary:focus-visible {
    outline: 3px solid var(--lp-pink);
    outline-offset: 2px;
  }
  .menu :global(.menu-close),
  .menu[open] :global(.menu-open) {
    display: none;
  }
  .menu[open] :global(.menu-close) {
    display: block;
  }
  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - var(--lp-header-h));
    overflow-y: auto;
    padding: 8px var(--lp-section-x) 16px;
    background: var(--lp-white);
    border-bottom: 1px solid var(--lp-header-border);
    box-shadow: 0 18px 30px -18px rgba(31, 42, 55, 0.45);
  }
  .panel ul {
    max-width: var(--lp-header-max);
    margin: 0 auto;
  }
  .panel li + li {
    border-top: 1px solid var(--lp-rule);
  }
  .panel a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    font-size: var(--lp-text-base);
    font-weight: 600;
    color: var(--lp-dark);
    text-decoration: none;
  }
  .panel a:hover,
  .panel a[aria-current='page'] {
    color: var(--lp-pink-text);
  }
  .panel-phone {
    font-weight: 700;
  }
</style>
