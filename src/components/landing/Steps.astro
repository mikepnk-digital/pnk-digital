---
// "How it works" step cards. Optional sub-points (version B).
import Icon from './Icon.astro';
import type { Step } from '@/data/tech-support';

export interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---
<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="step">
        <div class="top">
          <span class="n" aria-hidden="true">{i + 1}</span>
          <span class="when">{s.when}</span>
        </div>
        <h3><span class="lp-sr-only">Step {i + 1}: </span>{s.title}</h3>
        <p>{s.body}</p>
        {s.points && s.points.length > 0 && (
          <ul class="points">
            {s.points.map((pt) => <li><Icon name="check" size={16} />{pt}</li>)}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }
  .step {
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .n {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--lp-pink-tint);
    color: var(--lp-pink-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
  }
  .when {
    font-size: 14px;
    font-weight: 700;
    color: var(--lp-muted);
    background: var(--lp-surface);
    padding: 6px 12px;
    border-radius: var(--lp-radius-badge);
  }
  h3 {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
  }
  .points :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--lp-pink-text);
  }
</style>
