---
// "How it works" step cards. Optional sub-points (version B) and labelled
// routes (home: Support and AI side by side in one step).
import Icon from './Icon.astro';
import type { Step } from '@/data/tech-support';

export interface Props {
  steps: Step[];
  /** Four steps: 1, then 2, then 4 across (default three: 1, then 3). */
  columns?: 3 | 4;
}
const { steps, columns = 3 } = Astro.props;
---
<ol class:list={['steps', { four: columns === 4 }]} data-reveal-stagger>
  {
    steps.map((s, i) => (
      <li class="step">
        <div class="top">
          <span class="n" aria-hidden="true">{i + 1}</span>
          {s.when && <span class="when">{s.when}</span>}
        </div>
        <h3><span class="lp-sr-only">Step {i + 1}: </span>{s.title}</h3>
        {s.body && <p>{s.body}</p>}
        {s.routes && s.routes.length > 0 && (
          <dl class="routes">
            {s.routes.map((r) => (
              <div>
                <dt>{r.label}</dt>
                <dd>{r.body}</dd>
              </div>
            ))}
          </dl>
        )}
        {s.points && s.points.length > 0 && (
          <ul class="points">
            {s.points.map((pt) => <li><Icon name="check" size={16} />{pt}</li>)}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<style>
  /* Stacked, then all three in a row from 860px (auto-fit gave 2+1). */
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  @media (min-width: 860px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 640px) {
    .steps.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .steps.four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .step {
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  /* Border firms up on hover, as on the home cards. */
  .step {
    transition: border-color 0.3s ease;
  }
  .step:hover {
    border-color: var(--lp-border-strong);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .n {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--lp-pink-tint);
    color: var(--lp-pink-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--lp-text-md);
    font-weight: 800;
  }
  .when {
    font-size: var(--lp-text-sm);
    font-weight: 700;
    color: var(--lp-muted);
    background: var(--lp-surface);
    padding: 6px 12px;
    border-radius: var(--lp-radius-badge);
  }
  h3 {
    font-size: var(--lp-h3);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  p {
    font-size: var(--lp-text-base);
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .routes {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  dt {
    font-size: var(--lp-eyebrow-size);
    font-weight: var(--lp-eyebrow-weight);
    letter-spacing: var(--lp-eyebrow-track);
    text-transform: uppercase;
    color: var(--lp-pink-text);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    font-size: var(--lp-text-base);
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: var(--lp-text-sm);
    font-weight: 600;
    line-height: 1.45;
  }
  .points :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--lp-pink-text);
  }
</style>
