---
// Plans: heading, three PricingCards, then an optional note, any slotted
// content and an optional CtaStrip.
import PricingCard from './PricingCard.astro';
import CtaStrip from './CtaStrip.astro';
import type { Plan, PlanId } from '@/data/tech-support';

export interface Props {
  /** Section anchor, e.g. "pricing" (default "plans"). */
  id?: string;
  eyebrow?: string;
  title: string;
  lead: string;
  plans: Plan[];
  highlight: PlanId;
  /** Bold lead-in, e.g. "Extra hours £80/hour." */
  noteStrong?: string;
  note?: string;
  ctaText?: string;
  /** Passed to every PricingCard (defaults live there). */
  badge?: string;
  cardCta?: string;
  cardConfirm?: string;
}
const {
  id = 'plans',
  eyebrow = 'Plans',
  title,
  lead,
  plans,
  highlight,
  noteStrong,
  note,
  ctaText,
  badge,
  cardCta,
  cardConfirm,
} = Astro.props;
---
<section id={id} class="lp-section lp-section--surface" aria-labelledby={`${id}-title`}>
  <div class="lp-container lp-stack">
    <div class="lp-intro intro">
      <span class="lp-eyebrow">{eyebrow}</span>
      <h2 id={`${id}-title`} class="lp-h2">{title}</h2>
      <p class="lp-lead">{lead}</p>
    </div>
    <div class="cards" data-reveal-stagger>
      {
        plans.map((p) => (
          <PricingCard plan={p} popular={p.id === highlight} badge={badge} ctaLabel={cardCta} confirm={cardConfirm} />
        ))
      }
    </div>
    {(noteStrong || note) && <p class="note" data-reveal><strong>{noteStrong}</strong> {note}</p>}
    <slot />
    {ctaText && <CtaStrip text={ctaText} tone="card" />}
  </div>
</section>

<style>
  .intro {
    max-width: 700px;
  }
  /* One centred column until three fit side by side with the CTA label on one
     line (1120px); auto-fit left a 2+1 orphan from 700 to 1100px. */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 620px;
    margin-inline: auto;
    gap: 24px;
    padding-top: 16px;
    align-items: stretch;
  }
  @media (min-width: 1120px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
    }
  }
  .note {
    font-size: var(--lp-text-base);
    line-height: 1.6;
    color: var(--lp-muted);
    text-align: center;
  }
  .note strong {
    color: var(--lp-ink);
  }
</style>
