---
// Mobile-only (<760px) fixed booking bar. Hidden until the page has scrolled
// 560px, and hidden again while the booking band, the final CTA or the
// footer is on screen, so it never doubles up a visible pink button. Pure
// enhancement: without JS it never shows.
import { CALL_LABEL } from '@/config/site';

export interface Props {
  /** Optional two-line label beside the button; without it the button is full width. */
  label?: [string, string];
  cta?: string;
}
const { label, cta = CALL_LABEL } = Astro.props;
---
<div class="sticky" role="region" aria-label="Book a call" data-sticky-cta hidden>
  {label && <span class="label">{label[0]}<br />{label[1]}</span>}
  <a class="lp-btn lp-btn--pink btn" href="#book" data-book>{cta}</a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const blockers = document.querySelectorAll<HTMLElement>('[data-booking-band], [data-sticky-hide]');
  if (bar) {
    const compact = window.matchMedia('(max-width: 759.98px)');
    const visible = new Set<Element>();
    const update = () => {
      bar.hidden = !(compact.matches && window.scrollY > 560 && visible.size === 0);
    };
    if (blockers.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target);
          else visible.delete(e.target);
        }
        update();
      });
      blockers.forEach((el) => io.observe(el));
    }
    window.addEventListener('scroll', update, { passive: true });
    compact.addEventListener('change', update);
    update();
  }
</script>

<style>
  .sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--lp-white);
    border-top: 1px solid var(--lp-border);
    box-shadow: var(--lp-sticky-shadow);
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sticky[hidden] {
    display: none;
  }
  .label {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--lp-dark);
  }
  .btn {
    flex: 1 1 auto;
    padding: 13px 22px;
    min-height: 52px;
  }
</style>
