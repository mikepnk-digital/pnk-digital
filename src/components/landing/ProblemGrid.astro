---
// Four pain points. 'cards' (A): tinted cards numbered 01–04.
// 'grid' (B): bordered grid with 1px dividers and slate line icons.
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

export interface ProblemItem {
  title: string;
  body: string;
  icon?: IconName;
}
export interface Props {
  items: ProblemItem[];
  variant: 'cards' | 'grid';
}
const { items, variant } = Astro.props;
---
<ul class:list={['grid', variant]}>
  {
    items.map((it, i) => (
      <li class="item">
        {variant === 'cards' ? (
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
        ) : (
          it.icon && <span class="icon"><Icon name={it.icon} size={22} /></span>
        )}
        <h3>{it.title}</h3>
        <p>{it.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 20px;
  }
  .item {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cards .item {
    background: var(--lp-surface);
    border-radius: var(--lp-radius-card);
  }
  .grid:not(.cards) {
    gap: 1px;
    background: var(--lp-border);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    overflow: hidden;
  }
  .grid:not(.cards) .item {
    background: var(--lp-white);
  }
  .num {
    font-size: 15px;
    font-weight: 800;
    color: var(--lp-pink-text);
  }
  .icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--lp-surface);
    color: var(--lp-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  h3 {
    font-size: 20px;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .grid:not(.cards) h3 {
    font-size: 19px;
    letter-spacing: 0;
  }
  p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--lp-muted);
  }
</style>
