---
// Closing slate band: title, lead paragraphs (default slot, class
// "final-lead"), the booking button and a phone link. Hides the sticky bar.
import Icon from './Icon.astro';
import { CALL_LABEL, PHONE_DISPLAY, PHONE_HREF } from '@/config/site';

export interface Props {
  title: string;
  cta?: string;
}
const { title, cta = CALL_LABEL } = Astro.props;
---
<section class="lp-section final" aria-labelledby="final-title" data-sticky-hide>
  <div class="lp-container final-inner">
    <h2 id="final-title" class="final-title">{title}</h2>
    <slot />
    <div class="final-ctas">
      <a class="lp-btn lp-btn--pink" href="#book" data-book>{cta}</a>
      <a class="final-call" href={PHONE_HREF} data-phone>
        <Icon name="phone" size={18} />Call PNK Digital <span>{PHONE_DISPLAY}</span>
      </a>
    </div>
    <p class="final-fine">No obligation. No hard sell.</p>
  </div>
</section>

<style>
  .final {
    background: var(--lp-slate);
    color: var(--lp-white);
    /* Pink rings are 3.4:1 on slate and pink-button rings would be 1:1. */
    --lp-focus: var(--lp-white);
    --lp-focus-on-pink: var(--lp-white);
  }
  .final-inner {
    max-width: 820px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .final-title {
    font-size: var(--lp-h2);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .final-inner :global(.final-lead) {
    font-size: 19px;
    line-height: 1.55;
    color: var(--lp-on-slate-muted);
  }
  .final-inner :global(.final-lead strong) {
    color: var(--lp-white);
  }
  .final-ctas {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 28px;
  }
  .final-call {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    font-size: 18px;
    font-weight: 700;
    color: var(--lp-white);
    text-decoration: underline;
    text-decoration-color: var(--lp-pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
    border-radius: 4px;
  }
  .final-call span {
    font-weight: 600;
    color: var(--lp-on-slate-muted);
  }
  .final-call:hover {
    color: var(--lp-white);
    text-decoration-color: var(--lp-white);
  }
  .final-fine {
    font-size: 15px;
    font-weight: 600;
    color: var(--lp-on-slate-muted);
  }
  @media (max-width: 559.98px) {
    .final-ctas,
    .final-ctas .lp-btn {
      width: 100%;
    }
  }
</style>
