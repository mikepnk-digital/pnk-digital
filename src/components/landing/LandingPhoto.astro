---
// Optional photo slot. Looks for src/assets/landing/<photo>.{jpg,jpeg,png,webp,avif}
// at build time and renders it with <Image>. If the file is missing it renders a
// neutral decorative block, so the page still builds and looks intentional.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  photo: 'mike-hero' | 'mike-founder';
  alt: string;
  /** Rendered width hint for responsive srcset. */
  widths: number[];
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { photo, alt, widths, sizes, class: className, loading = 'lazy' } = Astro.props;

const files = import.meta.glob<ImageMetadata>('/src/assets/landing/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});
const match = Object.entries(files).find(([path]) => path.replace(/^.*\/|\.[^.]+$/g, '') === photo);
const image = match?.[1];
---
{
  image ? (
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      class:list={['photo', className]}
    />
  ) : (
    <div class:list={['photo', 'fallback', className]} aria-hidden="true">
      <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" />
      </svg>
    </div>
  )
}

<style>
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--lp-surface-2), var(--lp-pink-tint));
    color: var(--lp-input-border);
  }
</style>
