---
// Inline 24×24 stroke icons from the Tech Support Plans design handoff
// (Lucide-equivalent shapes). Decorative by default (aria-hidden).
export type IconName =
  | 'check'
  | 'clock'
  | 'arrow'
  | 'monitor'
  | 'monitor-x'
  | 'mail'
  | 'shield'
  | 'shield-check'
  | 'zap'
  | 'lock'
  | 'network'
  | 'file'
  | 'chat'
  | 'tag'
  | 'plus';

export interface Props {
  name: IconName;
  size?: number;
  /** Defaults: 3 for check, 2.6 for plus, 2.2 for clock/arrow, else 2. */
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  check: '<path d="m5 12 5 5 9-10"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  arrow: '<path d="M4 12h12M12 6l6 6-6 6"/>',
  monitor: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  'monitor-x': '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M9 9l6 4M15 9l-6 4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  shield: '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/>',
  'shield-check': '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  zap: '<path d="M13 3 5 13h6l-1 8 8-10h-6l1-8Z"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  network:
    '<circle cx="6" cy="7" r="3"/><circle cx="18" cy="7" r="3"/><circle cx="12" cy="18" r="3"/><path d="M8.5 9.5 10.5 15.5M15.5 9.5 13.5 15.5"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>',
  tag: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
};

const defaultStroke: Partial<Record<IconName, number>> = { check: 3, plus: 2.6, clock: 2.2, arrow: 2.2 };
const sw = strokeWidth ?? defaultStroke[name] ?? 2;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
