---
// Inline 24×24 stroke icon (shapes in ./icons.ts). Decorative by default
// (aria-hidden).
import { iconPaths, type IconName } from './icons';

export type { IconName };

export interface Props {
  name: IconName;
  size?: number;
  /** Defaults: 3 for check, 2.6 for plus, 2.2 for clock/arrow, else 2. */
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth, class: className } = Astro.props;

const defaultStroke: Partial<Record<IconName, number>> = { check: 3, plus: 2.6, clock: 2.2, arrow: 2.2 };
const sw = strokeWidth ?? defaultStroke[name] ?? 2;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={iconPaths[name]}
/>
