---
// One plan card. The highlighted plan gets the pink outline, "Most popular"
// badge and a pink button; others get an outline button that fills on hover.
// Buttons are #book anchors (work without JS); landing.ts pre-selects the plan.
// Price reads "[from] £1,950 <suffix>", suffix defaulting to "/month".
import Icon from './Icon.astro';
import type { Plan } from '@/data/tech-support';
import { CALL_LABEL } from '@/config/site';

export interface Props {
  plan: Plan;
  popular?: boolean;
  badge?: string;
  ctaLabel?: string;
  /** Small line under the button; omitted when empty. */
  confirm?: string;
}
const {
  plan,
  popular = false,
  badge = 'Most popular',
  ctaLabel = CALL_LABEL,
  confirm = "We'll confirm the right plan on the call",
} = Astro.props;
const titleId = `plan-${plan.id}-title`;
---
<article class:list={['card', { popular }]} aria-labelledby={titleId}>
  {popular && <span class="badge">{badge}</span>}
  <div class="head">
    <h3 id={titleId}>{plan.name}</h3>
    {plan.positioning && <p class="positioning">{plan.positioning}</p>}
    <p class="tagline">{plan.tagline}</p>
  </div>
  <p class="price">
    {plan.from && <span class="unit">from</span>}
    <span class="amount">£{plan.price.toLocaleString('en-GB')}</span>
    <span class="unit">{plan.priceSuffix ?? '/month'}</span>
  </p>
  {
    (plan.hours || plan.response) && (
      <ul class="meta">
        {plan.hours && <li><Icon name="clock" size={18} />{plan.hours}</li>}
        {plan.response && <li><Icon name="arrow" size={18} />{plan.response}</li>}
      </ul>
    )
  }
  <div class="action">
    <a
      class:list={['lp-btn', 'lp-btn--block', popular ? 'lp-btn--pink' : 'lp-btn--outline']}
      href="#book"
      data-book
      data-plan={plan.name}
      aria-label={`${ctaLabel}, ${plan.name} plan`}
    >{ctaLabel}</a>
    {confirm && <p class="confirm">{confirm}</p>}
  </div>
  <div class="features">
    {plan.includes && <p class="includes">{plan.includes}</p>}
    <ul>
      {
        plan.features.map((f) => (
          <li>
            <Icon name="check" size={18} />
            {typeof f === 'string' ? <span>{f}</span> : <span>{f.before}<a href={f.link.href}>{f.link.label}</a>{f.after}</span>}
          </li>
        ))
      }
    </ul>
    {plan.detail && <p class="detail">{plan.detail}</p>}
    {plan.note && <p class="note">{plan.note}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    height: 100%;
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card-lg);
    padding: 36px 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .popular::before {
    content: '';
    position: absolute;
    inset: -2px;
    border: 3px solid var(--lp-pink);
    border-radius: calc(var(--lp-radius-card-lg) + 2px);
    pointer-events: none;
  }
  .badge {
    position: absolute;
    top: -15px;
    left: 26px;
    background: var(--lp-pink-text);
    color: var(--lp-white);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 6px 14px;
    border-radius: var(--lp-radius-badge);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .positioning {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.35;
    color: var(--lp-pink-text);
  }
  .tagline {
    font-size: 16px;
    line-height: 1.5;
    color: var(--lp-muted);
  }
  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
  }
  .amount {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .unit {
    font-size: 17px;
    font-weight: 600;
    color: var(--lp-muted);
  }
  .meta {
    padding: 16px 18px;
    background: var(--lp-surface);
    border-radius: var(--lp-radius-inner);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
  }
  .meta li {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .meta :global(svg) {
    flex: none;
  }
  .action {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .confirm {
    text-align: center;
    font-size: 14px;
    color: var(--lp-muted);
  }
  .features {
    border-top: 1px solid var(--lp-header-border);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .includes {
    font-size: 15px;
    font-weight: 800;
  }
  .features ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .features li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.45;
  }
  .detail {
    margin-top: auto;
    padding-top: 6px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--lp-muted);
  }
  .detail + .note {
    margin-top: 0;
    padding-top: 0;
  }
  .note {
    margin-top: auto;
    padding-top: 6px;
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
    color: var(--lp-muted);
  }
  .features :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--lp-pink-text);
  }
</style>
