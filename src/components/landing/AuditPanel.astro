---
// /ai-consulting hero mock-up: an "AI Opportunity Audit" with ranked workflow
// cards, for HeroCompany's `panel` slot. Same frame, bar and pill styling as
// the client-portal mock in HeroCompany.astro, labelled "Illustrative example".
export interface Props {
  title: string;
  rows: { title: string; hours: string; state: string }[];
  footer: string;
}
const { title, rows, footer } = Astro.props;
const label = `Illustration of an AI Opportunity Audit ranking three workflows by hours saved per month: ${rows
  .map((r) => `${r.title}, ${r.hours}, ${r.state}`)
  .join('; ')}.`;
---
<div class="frame" role="img" aria-label={label}>
  <div class="portal">
    <div class="bar">
      <span class="title"><span class="pnk">PNK</span>{title}</span>
      <span class="example">Illustrative example</span>
    </div>
    <div class="content">
      <ol class="rows">
        {
          rows.map((r, i) => (
            <li class="row">
              <span class="rank">{i + 1}</span>
              <span class="text">
                <span class="row-title">{r.title}</span>
                <span class="hours">{r.hours}</span>
              </span>
              <span class:list={['pill', r.state.toLowerCase()]}>{r.state}</span>
            </li>
          ))
        }
      </ol>
      <p class="foot">{footer}</p>
    </div>
  </div>
</div>

<style>
  .frame {
    flex: 1 1 400px;
    max-width: 520px;
    min-width: 0;
    background: var(--lp-slate);
    border-radius: var(--lp-radius-panel);
    padding: clamp(12px, 2vw, 18px);
    box-shadow: var(--lp-hero-shadow);
  }
  .portal {
    background: var(--lp-white);
    border-radius: var(--lp-radius-inner);
    overflow: hidden;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--lp-border);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 800;
  }
  .pnk {
    color: var(--lp-pink-text);
  }
  .example {
    flex: none;
    font-size: 12px;
    font-weight: 700;
    color: var(--lp-muted);
    background: var(--lp-surface);
    padding: 3px 8px;
    border-radius: 6px;
  }
  .content {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-inner);
    padding: 12px;
  }
  .row:first-child {
    border-color: var(--lp-pink);
  }
  .rank {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--lp-pink-tint);
    color: var(--lp-pink-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
  }
  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row-title {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }
  .hours {
    font-size: 13px;
    font-weight: 700;
    color: var(--lp-success-text);
  }
  .pill {
    flex: none;
    font-size: 12px;
    font-weight: 800;
    color: var(--lp-slate);
    background: var(--lp-surface-2);
    padding: 4px 9px;
    border-radius: 6px;
  }
  .pill.pilot {
    color: var(--lp-white);
    background: var(--lp-pink-text);
  }
  .pill.next {
    color: var(--lp-success-text);
    background: var(--lp-success-tint);
  }
  .foot {
    font-size: 12px;
    font-weight: 600;
    color: var(--lp-muted);
  }
</style>
