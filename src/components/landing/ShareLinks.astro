---
// "Share:" an X (Twitter) intent link and a copy-link button for a blog post.
// The copy button needs JS and the Clipboard API, so it stays hidden without them.
import Icon from './Icon.astro';

export interface Props {
  title: string;
  slug: string;
}
const { title, slug } = Astro.props;
const url = `https://pnk-digital.com/blog/${slug}`;
---
<div class="share" data-share>
  <span class="label">Share:</span>
  <a
    class="btn"
    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on X"
  >
    <Icon name="twitter" size={18} />
  </a>
  <button type="button" class="btn" aria-label="Copy link" data-copy={url} hidden>
    <Icon name="link" size={18} />
  </button>
  <span class="copied" role="status" data-copied></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    const status = btn.parentElement!.querySelector<HTMLElement>('[data-copied]')!;
    let timer = 0;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      status.textContent = 'Copied!';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => (status.textContent = ''), 2000);
    });
  });
</script>

<style>
  .share {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .label {
    margin-right: 4px;
    font-size: var(--lp-text-sm);
    color: var(--lp-muted);
  }
  .btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--lp-muted);
    cursor: pointer;
  }
  .btn[hidden] {
    display: none;
  }
  .btn:hover {
    background: var(--lp-surface-2);
    color: var(--lp-pink-text);
  }
  .copied {
    font-size: var(--lp-text-sm);
    font-weight: 700;
    color: var(--lp-pink-text);
  }
</style>
