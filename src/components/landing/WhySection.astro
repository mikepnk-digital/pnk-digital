---
// Version B: four icon reasons beside the ServiceStandards panel.
// Honesty rule: no names, team size, locations, years, certifications or stats.
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import ServiceStandards from './ServiceStandards.astro';

const reasons: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'shield',
    title: 'Financial-services standards',
    body: "Our approach comes from financial services and insurance, where security and reliability aren't optional.",
  },
  {
    icon: 'file',
    title: 'Documented setups',
    body: "Everything we manage is written down, so your knowledge isn't locked in one person's head.",
  },
  {
    icon: 'chat',
    title: 'One point of contact',
    body: 'A dedicated contact who knows your business, your setup and your history.',
  },
  {
    icon: 'tag',
    title: 'Transparent fixed pricing',
    body: 'Published prices, a fixed monthly fee, and no extra work billed without your OK.',
  },
];
---
<section class="lp-section" aria-labelledby="why-title">
  <div class="lp-container row">
    <div class="main">
      <div class="lp-intro">
        <span class="lp-eyebrow">Why PNK Digital</span>
        <h2 id="why-title" class="lp-h2">Support you can rely on, built on proper standards</h2>
      </div>
      <ul class="reasons">
        {
          reasons.map((r) => (
            <li>
              <Icon name={r.icon} size={28} />
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <ServiceStandards />
  </div>
</section>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(36px, 5vw, 64px);
    align-items: flex-start;
  }
  .main {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 28px 32px;
  }
  .reasons li {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .reasons :global(svg) {
    color: var(--lp-pink-text);
  }
  h3 {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.3;
  }
  p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--lp-muted);
  }
</style>
