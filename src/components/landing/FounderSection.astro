---
// Version A: founder section with Mike's photo and three bold-led points.
import Icon from './Icon.astro';
import LandingPhoto from './LandingPhoto.astro';
import { YEARS_EXPERIENCE } from '@/config/site';

const points: [string, string][] = [
  ['Built where it matters.', `${YEARS_EXPERIENCE} years in financial services and insurance, where security and reliability aren't optional.`],
  ['One person, start to finish.', 'No account managers or ticket queues. The person you email is the person who fixes it.'],
  ['Plain English, always.', "You'll know what was done, why, and anything you need to decide."],
];
---
<section class="lp-section" aria-labelledby="why-title">
  <div class="lp-container row">
    <div class="photo">
      <LandingPhoto
        photo="mike-founder"
        alt="Mike, founder of PNK Digital"
        widths={[460, 920]}
        sizes="(min-width: 760px) 460px, calc(100vw - 40px)"
      />
    </div>
    <div class="copy">
      <span class="lp-eyebrow">Why PNK Digital</span>
      <h2 id="why-title" class="lp-h2">You deal directly with the person doing the work</h2>
      <p class="intro">
        PNK Digital is run by Mike Pink, who has spent {YEARS_EXPERIENCE} years building systems in financial services and insurance. PNK Digital brings that same standard to local businesses – without the corporate price tag or the call centre.
      </p>
      <ul class="points">
        {
          points.map(([lead, rest]) => (
            <li>
              <Icon name="check" size={22} />
              <span><strong>{lead}</strong> {rest}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
  }
  .photo {
    flex: 1 1 320px;
    max-width: 460px;
    min-width: 0;
    height: clamp(340px, 40vw, 480px);
    border-radius: var(--lp-radius-panel);
    overflow: hidden;
  }
  .copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .intro {
    font-size: 18px;
    line-height: 1.65;
    color: var(--lp-muted);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .points li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 17px;
    line-height: 1.55;
    color: var(--lp-muted);
  }
  .points :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--lp-pink-text);
  }
  strong {
    color: var(--lp-ink);
  }
</style>
