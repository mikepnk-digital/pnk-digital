---
// The document shell for every page: HeadMeta (SEO meta, favicons, gtag), the
// self-hosted font, motion and the design system (tokens on
// `.landing[data-theme]`, plus the `.lp-*` primitives). No header or footer:
// SiteLayout adds the site ones; landing and audit pages bring their own.
import HeadMeta from '../components/seo/HeadMeta.astro';
import type { Props as HeadMetaProps } from '../components/seo/HeadMeta.astro';
// Plus Jakarta Sans (OFL), self-hosted: one variable file per subset covers
// weights 200–800. Latin is preloaded; latin-ext loads only when a page uses it.
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import jakartaLatinExt from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-ext-wght-normal.woff2?url';

export type Props = HeadMetaProps & {
  theme: 'a' | 'b';
};

const { theme, ...seo } = Astro.props;

const fontFace = (src: string, range: string) =>
  `@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:200 800;font-display:swap;src:url(${src}) format('woff2');unicode-range:${range}}`;
const fontCss =
  fontFace(
    jakartaLatin,
    'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'
  ) +
  fontFace(
    jakartaLatinExt,
    'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'
  );
---
<!doctype html>
<html lang="en-GB" class="lp-html">
  <head>
    <HeadMeta {...seo} />
    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      // lp-motion turns on the scroll reveals (lib/landing-motion.ts). Set here,
      // before first paint, so revealed content never flashes; dropped after 3s
      // if the module hasn't run, so content can't stay hidden.
      (function () {
        var d = document.documentElement;
        d.classList.add('lp-js');
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('lp-motion');
        setTimeout(function () {
          if (!window.__lpMotion) d.classList.remove('lp-motion');
        }, 3000);
      })();
    </script>
  </head>
  <body class="lp-body">
    <div class="landing" data-theme={theme}>
      <slot />
    </div>
  </body>
</html>

<script>
  import { initLandingMotion } from '@/lib/landing-motion';
  initLandingMotion();
</script>

<style is:global>
  /* Page-level rules, limited to landing documents via .lp-html/.lp-body. */
  .lp-html {
    /* Landing header height (LandingHeader is fixed to it). Also the offset
       for anchor jumps here and for BookingForm's scroll to #book. */
    --lp-header-h: 72px;
    scroll-padding-top: var(--lp-header-h);
    -webkit-text-size-adjust: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lp-html {
      scroll-behavior: smooth;
    }
  }
  .lp-body {
    margin: 0;
    background: #fff;
  }

  /* ---- Design tokens ---------------------------------------------------- */
  .landing {
    /* Shared */
    --lp-pink: #ec008c;
    /* Button fills only: white text passes AA at any size (4.85:1), so button
       text can be 17px. Bands and accents stay --lp-pink. */
    --lp-pink-cta: #db0082;
    --lp-pink-hover: #c8007a;
    --lp-pink-text: #b3006b;
    --lp-pink-tint: #fdeef6;
    --lp-white: #ffffff;
    --lp-success: #15803d;
    --lp-success-text: #0f5d2e;
    --lp-success-tint: #e3f3e8;
    --lp-footer-logo: #ff5cb0;
    --lp-ink: #1b1720;
    --lp-font: 'Plus Jakarta Sans', system-ui, sans-serif;
    --lp-max: 1160px;
    --lp-header-max: 1288px;
    --lp-section-y: clamp(56px, 8vw, 112px);
    --lp-section-x: clamp(20px, 5vw, 64px);
    --lp-section-gap: clamp(32px, 4vw, 48px);
    --lp-h2: clamp(30px, 3.8vw, 46px);
    /* Type scale. Body text uses these six steps; h3s use --lp-h3. */
    --lp-text-xs: 13px;
    --lp-text-sm: 15px;
    --lp-text-base: 17px;
    --lp-text-md: 19px;
    --lp-text-lg: 22px;
    --lp-h3: 22px;
    --lp-h3-lg: 26px;
    /* Headings on the pink booking band. */
    --lp-h2-band: clamp(32px, 4.2vw, 50px);
    --lp-form-shadow: 0 30px 60px -30px rgba(60, 0, 35, 0.55);
    /* Focus rings. Dark sections override both to white. */
    --lp-focus: var(--lp-pink);
    --lp-focus-on-pink: var(--lp-dark);
  }

  /* Version A: warm neutrals, founder voice */
  .landing[data-theme='a'] {
    --lp-muted: #4a4550;
    --lp-subtle: #6b6470;
    --lp-surface: #faf7f5;
    --lp-surface-2: #f1ece8;
    --lp-border: #e7e2de;
    --lp-rule: #f0ebe7;
    --lp-header-border: #eee7e2;
    --lp-input-border: #8a8189;
    --lp-placeholder-border: #cfc7c1;
    --lp-border-strong: #d6cec8;
    --lp-dark: #1b1720;
    --lp-dark-hover: #3a3340;
    --lp-on-dark-muted: #d9d3dc;
    --lp-header-bg: rgba(255, 255, 255, 0.95);
    --lp-h1: clamp(38px, 5.6vw, 66px);
    --lp-h1-lh: 1.03;
    --lp-eyebrow-size: 14px;
    --lp-eyebrow-weight: 700;
    --lp-eyebrow-track: 0.06em;
    --lp-radius-btn: 999px;
    --lp-radius-header-btn: 999px;
    --lp-radius-card: 22px;
    --lp-radius-card-lg: 24px;
    --lp-radius-panel: 28px;
    --lp-radius-badge: 999px;
    --lp-radius-icon: 16px;
    --lp-radius-inner: 14px;
    --lp-hero-shadow: 0 24px 48px -32px rgba(27, 23, 32, 0.35);
    --lp-sticky-shadow: 0 -10px 30px -12px rgba(27, 23, 32, 0.25);
  }

  /* Version B: cool slate neutrals, company voice */
  .landing[data-theme='b'] {
    --lp-muted: #4b5563;
    --lp-subtle: #64748b;
    --lp-surface: #f4f6f9;
    --lp-surface-2: #eef1f5;
    --lp-border: #e3e7ed;
    --lp-rule: #e3e7ed;
    --lp-header-border: #e3e7ed;
    --lp-input-border: #64748b;
    --lp-placeholder-border: #cbd5e1;
    --lp-border-strong: #d5dbe3;
    --lp-slate: #1f2a37;
    --lp-slate-hover: #334155;
    --lp-dark: var(--lp-slate);
    --lp-dark-hover: var(--lp-slate-hover);
    --lp-on-dark-muted: #cbd5e1;
    --lp-on-slate-muted: #cbd5e1;
    --lp-on-slate-rule: #3b4757;
    --lp-header-bg: rgba(255, 255, 255, 0.96);
    --lp-h1: clamp(36px, 5.2vw, 62px);
    --lp-h1-lh: 1.04;
    --lp-eyebrow-size: 13px;
    --lp-eyebrow-weight: 800;
    --lp-eyebrow-track: 0.1em;
    --lp-radius-btn: 12px;
    --lp-radius-header-btn: 10px;
    --lp-radius-card: 20px;
    --lp-radius-card-lg: 20px;
    --lp-radius-panel: 24px;
    --lp-radius-badge: 8px;
    --lp-radius-icon: 14px;
    /* Panels nested inside cards (hero mock-up, audit panel, pricing). */
    --lp-radius-inner: 12px;
    --lp-hero-shadow: 0 30px 60px -30px rgba(31, 42, 55, 0.6);
    --lp-sticky-shadow: 0 -10px 30px -12px rgba(31, 42, 55, 0.25);
  }

  /* ---- Minimal reset, scoped to the landing wrapper ---------------------- */
  .landing {
    font-family: var(--lp-font);
    color: var(--lp-ink);
    background: var(--lp-white);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.5;
  }
  .landing *,
  .landing *::before,
  .landing *::after {
    box-sizing: border-box;
  }
  .landing :where(h1, h2, h3, h4, p, ul, ol, dl, dd, figure, blockquote) {
    margin: 0;
  }
  .landing :where(ul, ol) {
    list-style: none;
    padding: 0;
  }
  .landing :where(h1, h2, h3) {
    text-wrap: balance;
  }
  .landing :where(p) {
    text-wrap: pretty;
  }
  .landing :where(img, svg) {
    display: block;
    max-width: 100%;
  }
  .landing :where(button, input, select, textarea) {
    font: inherit;
    color: inherit;
  }
  .landing :where(a) {
    color: var(--lp-pink-text);
  }
  .landing :where(a:hover) {
    color: var(--lp-dark);
  }
  .landing :where(:focus-visible) {
    outline: 3px solid var(--lp-focus);
    outline-offset: 2px;
  }
  /* Scroll reveals (lib/landing-motion.ts), only under html.lp-motion. Not
     the URL's #target: the browser's jump to it would use the shifted box. */
  .lp-motion .landing :is(.lp-intro, [data-reveal], [data-reveal-stagger] > *):not(.is-in, :target) {
    opacity: 0;
    transform: translateY(24px);
  }
  /* !important: lp-anim is only present while the reveal runs, and must beat
     components' own (hover) transitions, whose scoped selectors tie on
     specificity and load later. */
  .lp-motion .landing .lp-anim {
    transition:
      opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) var(--lp-delay, 0ms),
      transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) var(--lp-delay, 0ms) !important;
  }
  @media print {
    .lp-motion .landing :is(.lp-intro, [data-reveal], [data-reveal-stagger] > *) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
  .landing .lp-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- Shared primitives used across landing components ----------------- */
  .landing .lp-section {
    padding: var(--lp-section-y) var(--lp-section-x);
  }
  .landing .lp-section--surface {
    background: var(--lp-surface);
  }
  .landing .lp-container {
    max-width: var(--lp-max);
    margin: 0 auto;
  }
  .landing .lp-stack {
    display: flex;
    flex-direction: column;
    gap: var(--lp-section-gap);
  }
  .landing .lp-intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 680px;
  }
  .landing .lp-eyebrow {
    font-size: var(--lp-eyebrow-size);
    font-weight: var(--lp-eyebrow-weight);
    letter-spacing: var(--lp-eyebrow-track);
    text-transform: uppercase;
    color: var(--lp-pink-text);
  }
  .landing .lp-h2 {
    font-size: var(--lp-h2);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .landing .lp-section--flush-top {
    padding-top: 0;
  }
  .landing .lp-stack--tight {
    gap: clamp(28px, 3.5vw, 40px);
  }
  /* Compare-plans heading: smaller H2 step. */
  .landing .lp-h2--sm {
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.1;
  }
  .landing .lp-lead {
    font-size: var(--lp-text-md);
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .landing .lp-ink {
    color: var(--lp-ink);
  }
  /* Keeps short figures like "10–100 people" on one line. */
  .landing .lp-nowrap {
    white-space: nowrap;
  }
  .landing .lp-statement {
    font-size: var(--lp-text-md);
    font-weight: 800;
    line-height: 1.45;
  }
  /* Two-column intro + card, stacking below ~900px. */
  .landing .lp-split {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 72px);
    align-items: flex-start;
  }
  .landing .lp-split > .lp-intro {
    flex: 1 1 420px;
    min-width: 0;
  }
  .landing .lp-split > :not(.lp-intro) {
    flex: 1 1 400px;
    min-width: 0;
  }

  /* Buttons. Pink CTAs keep 19px/700 white text: #ec008c only passes AA as large text. */
  .landing .lp-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--lp-text-base);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    border-radius: var(--lp-radius-btn);
    min-height: 56px;
    padding: 15px 28px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .landing .lp-btn--pink {
    background: var(--lp-pink-cta);
    color: var(--lp-white);
  }
  .landing .lp-btn--pink:hover {
    background: var(--lp-pink-hover);
    color: var(--lp-white);
  }
  .landing .lp-btn--outline {
    background: var(--lp-white);
    color: var(--lp-dark);
    border: 2px solid var(--lp-dark);
    padding: 13px 20px;
  }
  .landing .lp-btn--outline:hover {
    background: var(--lp-dark);
    color: var(--lp-white);
  }
  .landing .lp-btn--pink:focus-visible {
    outline: 3px solid var(--lp-focus-on-pink);
    outline-offset: 3px;
  }
  .landing .lp-btn--outline:focus-visible {
    outline: 3px solid var(--lp-focus);
    outline-offset: 3px;
  }
  .landing .lp-btn--block {
    width: 100%;
  }
  /* Full-width buttons don't need side padding for looks; less of it keeps
     the CTA label on one line in narrow cards. */
  .landing .lp-btn.lp-btn--block {
    padding-inline: 16px;
  }
  /* Phones: "Book a free 30-minute call" (about 220px at 17px) fits on one
     line in pricing cards and the booking band from 360px. */
  @media (max-width: 479.98px) {
    .landing .lp-btn {
      padding-inline: 16px;
    }
  }
  /* Below 360px the label drops to 15px so it still fits on one line in
     222px pricing cards (white on --lp-pink-cta passes AA at any size). */
  @media (max-width: 359.98px) {
    .landing .lp-btn,
    .landing .lp-btn.lp-btn--block {
      font-size: var(--lp-text-sm);
      padding-inline: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing *,
    .landing *::before,
    .landing *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
