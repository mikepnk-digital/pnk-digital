---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
  title="Page Not Found - PNK Digital"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <section class="lp-section notfound" aria-labelledby="notfound-title">
    <div class="lp-container lp-intro">
      <p class="lp-eyebrow">404</p>
      <h1 id="notfound-title" class="title">Page not found</h1>
      <p class="lp-lead">
        The page you're looking for doesn't exist or has moved. Let's get you back on track.
      </p>
      <div class="actions">
        <a class="lp-btn lp-btn--pink" href="/">Back to Home</a>
        <a class="lp-btn lp-btn--outline" href="/contact">Get in Touch</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .notfound .lp-intro {
    align-items: center;
  }
  .title {
    font-size: var(--lp-h1);
    line-height: var(--lp-h1-lh);
    letter-spacing: -0.035em;
    font-weight: 800;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }
</style>
