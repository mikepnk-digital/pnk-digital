---
import Layout from '../../layouts/Layout.astro';
import { BlogPostPage } from '../../react-pages/BlogPostPage';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { title: post.data.title, excerpt: post.data.excerpt },
  }));
}

const { slug } = Astro.params;
const { title, excerpt } = Astro.props;
---
<Layout title={`${title} - PNK Digital`} description={excerpt} ogType="article">
  <BlogPostPage slug={slug} client:load />
</Layout>
