---
// AI Consulting landing page (company voice, cool slate neutrals): same
// components, theme and section rhythm as /tech-support.
// Copy: "plans/AI Consulting Landing Page — Copy & Structure Spec.md", held in
// src/data/ai-consulting.ts. Unlike /tech-support, this page's approved copy
// states years of experience, market prices and illustrative hours saved.
// Sections shared with /tech-support are components in components/landing.
import LandingLayout from '@/layouts/LandingLayout.astro';
import LandingHeader from '@/components/landing/LandingHeader.astro';
import HeroCompany from '@/components/landing/HeroCompany.astro';
import AuditPanel from '@/components/landing/AuditPanel.astro';
import ServiceGrid from '@/components/landing/ServiceGrid.astro';
import CtaStrip from '@/components/landing/CtaStrip.astro';
import CompareStrip from '@/components/landing/CompareStrip.astro';
import PricingSection from '@/components/landing/PricingSection.astro';
import Steps from '@/components/landing/Steps.astro';
import FaqSection from '@/components/landing/FaqSection.astro';
import BookingBand from '@/components/landing/BookingBand.astro';
import LandingFooter from '@/components/landing/LandingFooter.astro';
import StickyCta from '@/components/landing/StickyCta.astro';
import Testimonial from '@/components/landing/Testimonial.astro';
import ProblemSplit from '@/components/landing/ProblemSplit.astro';
import WhySection from '@/components/landing/WhySection.astro';
import QuoteGrid from '@/components/landing/QuoteGrid.astro';
import ListCard from '@/components/landing/ListCard.astro';
import ExperienceGrid from '@/components/landing/ExperienceGrid.astro';
import FinalCta from '@/components/landing/FinalCta.astro';
import BookingCopy from '@/components/landing/BookingCopy.astro';
import CaseStudyCard from '@/components/landing/CaseStudyCard.astro';
import { getCaseStudyFor } from '@/lib/case-studies-collection';
import { faqPageJsonLd, serviceJsonLd } from '@/lib/structured-data';
import { LOCATION, RESPONSE_PROMISE, YEARS_EXPERIENCE } from '@/config/site';
import {
  BOOKING_SOURCE,
  PRIMARY_CTA,
  auditMock,
  booking,
  compare,
  disciplines,
  experience,
  faqs,
  hero,
  pilotExamples,
  pilotRoi,
  plans,
  principles,
  problems,
  quotes,
  reviewAreas,
  safetyItems,
  services,
  steps,
  testimonials,
} from '@/data/ai-consulting';

const variant = 'b';
const caseStudy = await getCaseStudyFor('ai');
const TITLE = `AI Consulting for Small Businesses in ${LOCATION.split(',')[1].trim()} & the UK | PNK Digital`;
const DESCRIPTION =
  'We find the processes AI can take off your team, build the first one into the tools you already use, and hand it over. Fixed prices from £1,950. Book a free 30-minute AI Fit Call.';
const CANONICAL = 'https://pnk-digital.com/ai-consulting';

const pull = testimonials.find((t) => t.pullQuote)!;
const navLinks = [
  { href: '#clients', label: 'Clients' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#how', label: 'How it works' },
  { href: '#faq', label: 'FAQ' },
];

// FAQPage + Service with one Offer per pricing card (prices exclude VAT, as
// the pricing lead says).
const jsonLd = [
  faqPageJsonLd(faqs),
  serviceJsonLd({
    name: 'AI Consulting',
    serviceType: 'AI consulting',
    description: DESCRIPTION,
    url: CANONICAL,
    pricingAnchor: 'pricing',
    plans,
    vatIncluded: false,
  }),
];
---
<LandingLayout
  theme={variant}
  title={TITLE}
  description={DESCRIPTION}
  canonical={CANONICAL}
  ogImage="/og/ai-consulting.png"
  twitterImage="/og/ai-consulting.png"
  jsonLd={jsonLd}
>
  <LandingHeader links={navLinks} />

  <main>
    <!-- 1. Hero -->
    <HeroCompany eyebrow={hero.eyebrow} title={hero.title} sub={hero.sub} reassurance={hero.reassurance} cta={PRIMARY_CTA}>
      <AuditPanel slot="panel" title={auditMock.title} rows={auditMock.rows} footer={auditMock.footer} />
    </HeroCompany>

    <!-- 2. Sound familiar? -->
    <ProblemSplit
      title="Everyone's using ChatGPT. Nothing has actually changed."
      problems={problems}
      answer="We work out where AI will pay in your business, build it, and show you the hours it saves."
    >
      <p class="lp-lead">
        Most businesses we talk to have already tried AI. Someone's got a subscription, a few people use it for emails,
        and the owner has sat through three sales demos.
      </p>
      <p class="lp-lead">
        But the work still takes as long as it did. Because nobody has looked at how the business actually runs, picked
        the right process, and built AI into it properly.
      </p>
    </ProblemSplit>

    <!-- 3. What we do -->
    <section id="services" class="lp-section lp-section--surface" aria-labelledby="services-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">What we do</span>
          <h2 id="services-title" class="lp-h2">From "where do we start?" to one workflow live and measured.</h2>
          <p class="lp-lead">
            We're not a strategy firm and we're not a software agency. We're the senior engineer who can do the thinking and
            the building, then hand it over.
          </p>
        </div>
        <ServiceGrid items={services} iconStyle="solid" columns={3} />
        <CtaStrip text="One person. One fixed price per step. Nothing built that you don't own." tone="card" cta={PRIMARY_CTA} />
      </div>
    </section>

    <!-- 4. How it compares -->
    <section class="lp-section" aria-labelledby="compare-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">How it compares</span>
          <h2 id="compare-title" class="lp-h2">Three ways to get AI into your business.</h2>
        </div>
        <CompareStrip
          caption="Strategy consultant, automation agency and PNK Digital compared"
          columns={compare.columns}
          rows={compare.rows}
          source={compare.source}
        />
      </div>
    </section>

    <!-- 5. Why PNK Digital -->
    <WhySection
      title="The AI consultant who ships."
      lead="PNK Digital isn't a marketing consultancy that learned prompting last year, and it isn't a helpdesk."
      disciplines={disciplines}
      principles={principles}
    >
      <p>
        We're software engineers with <strong>{YEARS_EXPERIENCE} years of delivering systems in financial services</strong> — insurance
        claims, pensions, life insurance — where data is sensitive and compliance is not optional. And we build with AI
        every day: agentic coding, multi-agent workflows, self-hosted models, document retrieval.
      </p>
      <Fragment slot="build">
        And if AI isn't right for your business yet, <strong>we'll say so in the audit</strong> and you'll have lost two
        weeks, not a year.
      </Fragment>
    </WhySection>

    <!-- 6. Who we help -->
    <section class="lp-section" aria-labelledby="who-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Who we help</span>
          <h2 id="who-title" class="lp-h2">Built for firms with real admin and real responsibilities.</h2>
          <p class="lp-lead">
            PNK Digital's AI work is designed for owner-led businesses of roughly <strong class="lp-ink">10–100 people</strong> in
            professional and financial services: insurance brokers, IFAs, accountants, solicitors, recruiters, property firms,
            and SaaS companies with a small dev team.
          </p>
        </div>
        <QuoteGrid
          quotes={quotes}
          intro="If you recognise any of these:"
          outro="…there is almost certainly one process worth starting with."
        />
      </div>
    </section>

    <!-- 6b. What a pilot can look like -->
    <section id="examples" class="lp-section lp-section--surface" aria-labelledby="examples-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Examples</span>
          <h2 id="examples-title" class="lp-h2">What a pilot can look like</h2>
          <p class="lp-lead">From email to onboarding: the kind of work a pilot can take off your team.</p>
        </div>
        <ServiceGrid items={pilotExamples} iconStyle="solid" columns={3} />
        <div class="roi">
          <h3 class="roi-title">Illustrative: 4 hours saved per person per week</h3>
          <CompareStrip
            caption="Illustrative time saved and annual value by team size, at 4 hours saved per person per week"
            columns={pilotRoi.columns}
            rows={pilotRoi.rows}
            source={pilotRoi.source}
            stack={false}
          />
        </div>
      </div>
    </section>

    <!-- 7. Client stories -->
    <section id="clients" class="lp-section" aria-labelledby="clients-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Client stories</span>
          <h2 id="clients-title" class="lp-h2">Businesses that trust us with the technology they run on.</h2>
        </div>
        <ul class="clients">
          {
            testimonials.map((t) => (
              <li>
                <Testimonial quote={t.quote} name={t.name} role={t.role} company={t.company} services={t.services} />
              </li>
            ))
          }
        </ul>
        {caseStudy && <CaseStudyCard study={caseStudy} />}
        <!-- Placeholder until an AI-specific client quote exists (spec, "Before launch"). -->
        <p class="clients-note">Our first AI pilots are live now. Ask about them on your free AI Fit Call.</p>
      </div>
    </section>

    <!-- 8. Pricing -->
    <PricingSection
      id="pricing"
      eyebrow="Pricing"
      title="Fixed prices. Decide one step at a time."
      lead="Each step has a price, a deliverable and a decision point. Nobody is asked to commit to the next step until the last one has paid for itself. All prices exclude VAT."
      plans={plans}
      highlight="ai-pilot"
      badge="Recommended"
      cardCta={PRIMARY_CTA}
      cardConfirm=""
    >
      <div class="more">
        <div class="more-copy">
          <div class="more-block">
            <h3>Just want to get your team started?</h3>
            <p>
              A half-day <strong>Team AI Workshop</strong> is <strong>£1,250</strong>: hands-on with your own documents and
              tools, and you leave with an AI use policy. Also available as a follow-on after any pilot.
            </p>
          </div>
          <div class="more-block">
            <h3>What happens if you need more?</h3>
            <p>Anything outside a fixed scope is quoted before we start. No day rates, no surprise invoices.</p>
          </div>
        </div>
        <a class="lp-btn lp-btn--pink" href="#book" data-book>{PRIMARY_CTA}</a>
      </div>
    </PricingSection>

    <!-- 9. How it works -->
    <section id="how" class="lp-section" aria-labelledby="how-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">How it works</span>
          <h2 id="how-title" class="lp-h2">Getting started is simple.</h2>
        </div>
        <Steps steps={steps} />
        <p class="how-close">You get on with running the business. We'll make the technology do more of the work.</p>
      </div>
    </section>

    <!-- 10. Book (booking form) -->
    <BookingBand
      variant={variant}
      calendar
      successLine={booking.successLine}
      form={{
        compact: true,
        source: BOOKING_SOURCE,
        analyticsPage: 'ai-consulting',
        messageLabel: "What takes up most of your team's time?",
        messagePlaceholder: '',
        reassurance: `No obligation. No hard sell. We'll reply ${RESPONSE_PROMISE}.`,
      }}
    >
      <BookingCopy
        slot="copy"
        title="Not sure where AI fits?"
        intro="Book a free 30-minute AI Fit Call and we'll talk through how your team actually works."
        outro="You'll leave with a clearer picture of what AI could take off your plate, and a straight answer on whether it's worth going further."
        areas={reviewAreas}
        pull={pull}
      />
    </BookingBand>

    <!-- 11. Safe by design -->
    <section class="lp-section lp-section--surface" aria-labelledby="safe-title">
      <div class="lp-container lp-split">
        <div class="lp-intro">
          <span class="lp-eyebrow">Safe by design</span>
          <h2 id="safe-title" class="lp-h2">AI should reduce your risk, not add to it.</h2>
          <p class="lp-lead">
            Most of the businesses we work with handle client data they're responsible for. So every workflow we build starts
            from what's safe, not from what's clever.
          </p>
          <p class="lp-statement">We don't believe in sending your data to tools nobody has checked.</p>
        </div>
        <ListCard icon="shield-check" title="What that looks like in practice:" items={safetyItems} />
      </div>
    </section>

    <!-- 12. Experience -->
    <section class="lp-section" aria-labelledby="exp-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Experience</span>
          <h2 id="exp-title" class="lp-h2">Technology expertise you can rely on.</h2>
          <p class="lp-lead">
            PNK Digital is built on {YEARS_EXPERIENCE} years of designing and delivering software for businesses, most of it in financial
            services. Our experience spans:
          </p>
        </div>
        <ExperienceGrid
          items={experience}
          close="So when you talk to PNK Digital about AI, you're not talking to someone who read about it."
          closeStrong="You're talking to someone who builds with it every day."
        />
      </div>
    </section>

    <!-- 13. FAQ -->
    <FaqSection
      title="Frequently asked questions"
      lead="Anything else? Ask us on your free AI Fit Call."
      items={faqs}
      surface
    />

    <!-- 14. Closing CTA -->
    <FinalCta title="Stop talking about AI. Put it to work." cta={PRIMARY_CTA}>
      <p class="final-lead">Your business has at least one process that's eating hours it doesn't need to.</p>
      <p class="final-lead">
        Get one experienced engineer who can <strong>find it, build it, measure it and hand it over.</strong>
      </p>
    </FinalCta>
  </main>

  <LandingFooter />
  <StickyCta />
</LandingLayout>

<script>
  // cta_click and a one-off pricing_view, tagged page: 'ai-consulting'. Phone
  // clicks (phone_clicked) are sent site-wide from HeadMeta; bookings and form
  // sends from BookingEmbed and BookingForm.
  const params = { variant: 'b', page: 'ai-consulting' };
  const track = (name: string, extra: Record<string, string> = {}) => {
    if (typeof window.gtag === 'function') window.gtag('event', name, { ...params, ...extra });
  };

  // Where the CTA sits: header, sticky bar, or the section's heading id.
  const ctaLocation = (el: Element) => {
    if (el.closest('header')) return 'header';
    if (el.closest('[data-sticky-cta]')) return 'sticky';
    return el.closest('section')?.getAttribute('aria-labelledby')?.replace(/-title$/, '') ?? 'page';
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-book]').forEach((link) => {
    link.addEventListener('click', () => {
      const extra: Record<string, string> = { cta_location: ctaLocation(link) };
      if (link.dataset.plan) extra.plan = link.dataset.plan;
      track('cta_click', extra);
    });
  });

  // Fires once the pricing section reaches the top 60% of the viewport. Not an
  // area threshold: stacked cards make the section several screens tall on phones.
  const pricing = document.getElementById('pricing');
  if (pricing && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          track('pricing_view');
          observer.disconnect();
        }
      },
      { rootMargin: '0px 0px -40% 0px' }
    );
    observer.observe(pricing);
  }
</script>

<style>
  /* 6b. What a pilot can look like */
  .roi {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .roi-title {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.3;
  }

  /* 7. Client stories: two-up on desktop, stacked on mobile. */
  .clients {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .clients-note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--lp-muted);
    text-align: center;
  }

  /* 8. Pricing: workshop + "What happens if you need more?" */
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    padding: clamp(22px, 3vw, 32px);
  }
  .more-copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .more-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .more h3 {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.3;
  }
  .more p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .more p strong {
    color: var(--lp-ink);
    font-weight: 800;
  }
  @media (max-width: 559.98px) {
    .more .lp-btn {
      width: 100%;
    }
  }

  /* 9. How it works */
  .how-close {
    font-size: clamp(19px, 2vw, 22px);
    font-weight: 800;
    line-height: 1.4;
    text-align: center;
  }
</style>
