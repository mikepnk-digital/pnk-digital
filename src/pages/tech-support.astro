---
// Tech Support Plans (company voice, cool slate neutrals). Formerly version B
// of the A/B test at /tech-support/service, which now 301s here (CloudFront).
// Positioning: "Your business technology, taken care of."
// Copy: design-assets/copy/pnk-digital-landing-page-copy.md, held in
// src/data/tech-support-service.ts.
// Honesty rule: no team size, years trading, certifications, client counts or
// statistics anywhere – copy, meta or alt text. Exceptions: client
// testimonials, which must use client-approved wording and names (see
// `testimonials` in tech-support-service.ts); Mike's photo and name in "Why
// PNK Digital"; and the contact details (phone, email, location from
// src/config/site.ts) and statutory company disclosure in the footer.
import LandingLayout from '@/layouts/LandingLayout.astro';
import LandingHeader from '@/components/landing/LandingHeader.astro';
import HeroCompany from '@/components/landing/HeroCompany.astro';
import ServiceGrid from '@/components/landing/ServiceGrid.astro';
import CtaStrip from '@/components/landing/CtaStrip.astro';
import PricingSection from '@/components/landing/PricingSection.astro';
import Steps from '@/components/landing/Steps.astro';
import FaqSection from '@/components/landing/FaqSection.astro';
import BookingBand from '@/components/landing/BookingBand.astro';
import LandingFooter from '@/components/landing/LandingFooter.astro';
import StickyCta from '@/components/landing/StickyCta.astro';
import Icon from '@/components/landing/Icon.astro';
import Testimonial from '@/components/landing/Testimonial.astro';
import LandingPhoto from '@/components/landing/LandingPhoto.astro';
import { RESPONSE_PROMISE } from '@/config/site';
import {
  PHONE_DISPLAY,
  PHONE_HREF,
  PRIMARY_CTA,
  automationItems,
  booking,
  disciplines,
  experience,
  faqs,
  plans,
  principles,
  problems,
  quotes,
  reviewAreas,
  securityItems,
  services,
  steps,
  testimonials,
} from '@/data/tech-support-service';

const variant = 'b';
const pull = testimonials.find((t) => t.pullQuote)!;
const navLinks = [
  { href: '#plans', label: 'Plans' },
  { href: '#clients', label: 'Clients' },
  { href: '#how', label: 'How it works' },
  { href: '#faq', label: 'FAQ' },
];
---
<LandingLayout
  theme={variant}
  title="Business Technology Support for Small Businesses | PNK Digital"
  description="Website, email, Microsoft 365, security, automation and technical support – managed by one experienced technology partner. Book a free 30-minute technology review."
>
  <LandingHeader links={navLinks} />

  <main>
    <!-- 1. Hero -->
    <HeroCompany />

    <!-- 2. Problem -->
    <section class="lp-section" aria-labelledby="problem-title">
      <div class="lp-container split">
        <div class="lp-intro">
          <span class="lp-eyebrow">Sound familiar?</span>
          <h2 id="problem-title" class="lp-h2">You shouldn't have to be your company's IT department.</h2>
          <p class="lp-lead">As your business grows, so does the technology behind it.</p>
          <p class="lp-lead">
            New employees need accounts. Your website needs updating. Email stops working. Someone needs to manage your
            domains. Security needs attention. And suddenly, you're spending your time figuring out technology instead of
            running your business.
          </p>
        </div>
        <div class="problem-card">
          <ul class="problem-list">
            {problems.map((p) => <li><span class="mark" aria-hidden="true"></span>{p}</li>)}
          </ul>
          <div class="problem-answer">
            <p class="answer-lead">That's where PNK Digital comes in.</p>
            <p>We become the person you can call when you need your business technology sorted.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Proposition / services -->
    <section id="services" class="lp-section lp-section--surface" aria-labelledby="services-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">What we look after</span>
          <h2 id="services-title" class="lp-h2">One partner for your business technology.</h2>
          <p class="lp-lead">
            Instead of managing a collection of suppliers, accounts and technical problems, you get one experienced partner
            who understands how everything fits together.
          </p>
        </div>
        <ServiceGrid items={services} iconStyle="solid" columns={3} />
        <CtaStrip
          text="One person. One point of contact. One place to go when technology gets in the way."
          tone="card"
          cta={PRIMARY_CTA}
        />
      </div>
    </section>

    <!-- 4. Differentiator -->
    <section class="lp-section diff" aria-labelledby="diff-title">
      <div class="lp-container diff-inner">
        <div class="diff-copy">
          <span class="lp-eyebrow diff-eyebrow">Why PNK Digital</span>
          <h2 id="diff-title" class="lp-h2">More than IT support.</h2>
          <p class="diff-lead">PNK Digital isn't a traditional IT helpdesk.</p>
          <p>
            We're software engineers and technology specialists who understand both{' '}<strong>how businesses use technology</strong> and <strong>how to build it</strong>. That means we're not limited to fixing what's broken.
          </p>
          <ul class="chips" aria-label="What we bring together">
            {disciplines.map((d) => <li>{d}</li>)}
          </ul>
          <figure class="founder">
            <div class="founder-photo">
              <LandingPhoto photo="mike-founder" alt="Mike Pink" widths={[120, 240]} sizes="120px" />
            </div>
            <figcaption>Mike Pink, founder — the person who does the work.</figcaption>
          </figure>
        </div>
        <div class="diff-panel">
          <ul class="principles">
            {principles.map((p) => <li>{p.lead} <strong>{p.rest}</strong></li>)}
          </ul>
          <p class="build">And if your business needs something that doesn't exist yet, <strong>we can build it.</strong></p>
          <p class="diff-foot">
            From a website problem to a custom business application, you have one technical partner who can help you find the
            right solution.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. Who we help -->
    <section class="lp-section" aria-labelledby="who-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Who we help</span>
          <h2 id="who-title" class="lp-h2">Built for businesses that have outgrown doing it themselves.</h2>
          <p class="lp-lead">
            PNK Digital is designed for small and growing businesses that need reliable technology support but aren't ready –
            or don't want – to employ a full-time IT team.
          </p>
          <p class="lp-lead">
            Typically, that's a business with around <strong class="ink">5–50 people</strong> that has reached the point where
            technology is too important to leave to chance, but doesn't need a full internal IT department.
          </p>
        </div>
        <div class="quotes-wrap">
          <p class="quotes-intro">If you're currently relying on:</p>
          <ul class="quotes">
            {quotes.map((q) => <li><Icon name="chat" size={20} /><q>{q}</q></li>)}
          </ul>
          <p class="quotes-outro">…it might be time to have someone properly looking after it.</p>
        </div>
      </div>
    </section>

    <!-- 5b. Client testimonials -->
    <section id="clients" class="lp-section lp-section--flush-top" aria-labelledby="clients-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Client stories</span>
          <h2 id="clients-title" class="lp-h2">Businesses that stopped worrying about their technology.</h2>
          <p class="lp-lead">A few words from businesses PNK Digital looks after today.</p>
        </div>
        <ul class="clients">
          {
            testimonials.map((t) => (
              <li>
                <Testimonial quote={t.quote} name={t.name} role={t.role} company={t.company} services={t.services} />
              </li>
            ))
          }
        </ul>
        <p class="clients-note">Want to hear more? Ask us about current clients on your free technology review.</p>
      </div>
    </section>

    <!-- 6. Pricing -->
    <PricingSection
      eyebrow="Pricing"
      title="Simple monthly support. No surprise bills."
      lead="Choose the level of support that's right for your business. If you're not sure, we'll help you work it out."
      plans={plans}
      highlight="business"
      badge="Recommended"
      cardCta={PRIMARY_CTA}
      cardConfirm=""
    >
      <div class="more">
        <div class="more-copy">
          <h3>What happens if you need more?</h3>
          <p>
            Each plan includes an agreed amount of hands-on work. If something needs more than that, a larger project or work
            outside your plan, we'll tell you <strong>before we do it</strong> and quote it as a fixed price. Plan clients get
            10% off project work.
          </p>
          <p class="more-strong">No unexpected invoices.</p>
        </div>
        <a class="lp-btn lp-btn--pink" href="#book" data-book>{PRIMARY_CTA}</a>
      </div>
    </PricingSection>

    <!-- 7. How it works -->
    <section id="how" class="lp-section" aria-labelledby="how-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">How it works</span>
          <h2 id="how-title" class="lp-h2">Getting started is simple.</h2>
        </div>
        <Steps steps={steps} />
        <p class="how-close">You get on with running the business. We'll look after the technology.</p>
      </div>
    </section>

    <!-- 8. Free technology review (booking form) -->
    <BookingBand
      variant={variant}
      calendar
      successLine={booking.successLine}
      form={{
        compact: true,
        messageLabel: 'What do you need help with?',
        messagePlaceholder: 'e.g. Nobody is sure who manages our domain, and new starters take days to set up',
        submitLabel: PRIMARY_CTA,
        reassurance: `No obligation. No hard sell. We'll reply ${RESPONSE_PROMISE}.`,
      }}
    >
      <Fragment slot="copy">
        <h2 id="book-title" class="review-title">Not sure what you actually need? <span>Let's take a look.</span></h2>
        <p class="review-intro">
          Book a free 30-minute technology review and we'll talk through the technology your business relies on.
        </p>
        <div>
          <p class="review-label">We'll look at things like:</p>
          <ul class="review-list">
            {reviewAreas.map((a) => <li><Icon name="check" size={20} />{a}</li>)}
          </ul>
        </div>
        <div class="review-quote">
          <Testimonial quote={pull.pullQuote!} name={pull.name} company={pull.company} variant="pull" />
        </div>
        <p class="review-intro">
          You'll leave with a clearer picture of what's working, what needs attention and where you could improve.
        </p>
        <p class="review-strong">No obligation. No hard sell. Just straightforward advice.</p>
        <p class="review-call">
          Prefer to talk? <a href={PHONE_HREF} data-phone>Call PNK Digital on {PHONE_DISPLAY}</a>
        </p>
      </Fragment>
    </BookingBand>

    <!-- 9. Experience -->
    <section class="lp-section" aria-labelledby="exp-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Experience</span>
          <h2 id="exp-title" class="lp-h2">Technology expertise you can rely on.</h2>
          <p class="lp-lead">
            PNK Digital is built on years of experience designing and developing software and technology for businesses. Our
            experience spans:
          </p>
        </div>
        <ul class="exp">
          {
            experience.map((e) => (
              <li>
                <span class="exp-icon"><Icon name={e.icon} size={24} /></span>
                <h3>{e.title}</h3>
                <p>{e.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="exp-close">
          <p>So when you contact PNK Digital, you're not simply getting someone who can reset a password.</p>
          <p class="exp-strong">
            You're getting access to someone who understands the technology underneath your business – and knows how to build
            with it.
          </p>
        </div>
      </div>
    </section>

    <!-- 10. Security -->
    <section class="lp-section lp-section--surface" aria-labelledby="sec-title">
      <div class="lp-container split">
        <div class="lp-intro">
          <span class="lp-eyebrow">Security</span>
          <h2 id="sec-title" class="lp-h2">Technology should make your business safer – not create another risk.</h2>
          <p class="lp-lead">
            Your business relies on email, cloud applications, websites and online accounts every day. We'll help make sure the
            basics are properly looked after.
          </p>
          <p class="lp-lead">We don't believe in selling unnecessary technology.</p>
          <p class="statement">We'll focus on the things that genuinely reduce risk for your business.</p>
        </div>
        <div class="list-card">
          <p class="list-card-title"><Icon name="shield-check" size={22} />That can include:</p>
          <ul class="ticks">
            {securityItems.map((s) => <li><Icon name="check" size={18} />{s}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 11. Automation & AI -->
    <section class="lp-section" aria-labelledby="auto-title">
      <div class="lp-container split">
        <div class="lp-intro">
          <span class="lp-eyebrow">Automation &amp; AI</span>
          <h2 id="auto-title" class="lp-h2">Spend less time doing work a computer could do for you.</h2>
          <p class="lp-lead">
            Not every business needs an AI chatbot. But almost every business has repetitive tasks that could be made simpler.
          </p>
          <p class="statement">The goal isn't to add more technology.</p>
          <p class="lp-lead">It's to give your team more time to do the work that actually matters.</p>
          <p class="lp-lead"><a href="/ai-consulting">Want AI built into a process, not just talked about? See AI consulting →</a></p>
        </div>
        <div class="list-card">
          <p class="list-card-title"><Icon name="zap" size={22} />We'll look at how your team works and find ways to:</p>
          <ul class="ticks">
            {automationItems.map((s) => <li><Icon name="check" size={18} />{s}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 12. FAQ -->
    <FaqSection
      title="Frequently asked questions"
      lead="Anything else? Ask us on your free technology review."
      items={faqs}
      surface
    />

    <!-- 13. Final CTA -->
    <section class="lp-section final" aria-labelledby="final-title">
      <div class="lp-container final-inner">
        <h2 id="final-title" class="final-title">Stop worrying about your technology.</h2>
        <p class="final-lead">
          Your business is too important to leave your technology to whoever happens to have the password.
        </p>
        <p class="final-lead">
          Get one experienced technology partner who can <strong>support it, secure it, improve it and build it.</strong>
        </p>
        <div class="final-ctas">
          <a class="lp-btn lp-btn--pink" href="#book" data-book>{PRIMARY_CTA}</a>
          <a class="final-call" href={PHONE_HREF} data-phone>
            <Icon name="phone" size={18} />Call PNK Digital <span>{PHONE_DISPLAY}</span>
          </a>
        </div>
        <p class="final-fine">No obligation. No hard sell.</p>
      </div>
    </section>
  </main>

  <LandingFooter />
  <StickyCta />
</LandingLayout>

<script>
  // Phone CTA clicks (secondary conversion), alongside BookingForm's tech_review_booked.
  document.querySelectorAll<HTMLAnchorElement>('[data-phone]').forEach((link) => {
    link.addEventListener('click', () => {
      if (typeof window.gtag === 'function') window.gtag('event', 'phone_click', { variant: 'b' });
    });
  });
</script>

<style>
  .ink {
    color: var(--lp-ink);
  }

  /* Two-column intro + card, stacking below ~900px. */
  .split {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 72px);
    align-items: flex-start;
  }
  .split > .lp-intro {
    flex: 1 1 420px;
    min-width: 0;
  }
  .split > :not(.lp-intro) {
    flex: 1 1 400px;
    min-width: 0;
  }
  .statement {
    font-size: 19px;
    font-weight: 800;
    line-height: 1.45;
  }

  /* 2. Problem */
  .problem-card {
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card-lg);
    overflow: hidden;
  }
  .problem-list {
    padding: clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .problem-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.45;
  }
  .mark {
    flex: none;
    width: 9px;
    height: 9px;
    margin-top: 8px;
    border-radius: 2px;
    background: var(--lp-pink);
  }
  .problem-answer {
    background: var(--lp-slate);
    color: var(--lp-white);
    padding: clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .answer-lead {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .problem-answer p:not(.answer-lead) {
    font-size: 16px;
    line-height: 1.55;
    color: var(--lp-on-slate-muted);
  }

  /* 4. Differentiator */
  .diff {
    background: var(--lp-slate);
    color: var(--lp-white);
  }
  .diff-inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .diff-copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  /* Light pink on slate (~5.3:1) passes AA for the small eyebrow text. */
  .diff-eyebrow {
    color: var(--lp-footer-logo);
  }
  .diff-lead {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.4;
  }
  .diff-copy > p:not(.diff-lead) {
    font-size: 17px;
    line-height: 1.65;
    color: var(--lp-on-slate-muted);
  }
  .diff-copy strong {
    color: var(--lp-white);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .chips li {
    font-size: 14px;
    font-weight: 700;
    padding: 7px 12px;
    border-radius: var(--lp-radius-badge);
    border: 1px solid var(--lp-on-slate-rule);
    color: var(--lp-white);
  }
  .founder {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 8px;
  }
  .founder-photo {
    flex: none;
    width: 120px;
    height: 120px;
    border-radius: var(--lp-radius-card);
    overflow: hidden;
  }
  .founder figcaption {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--lp-white);
  }
  @media (max-width: 379.98px) {
    .founder-photo {
      width: 96px;
      height: 96px;
    }
  }
  .diff-panel {
    flex: 1 1 420px;
    min-width: 0;
    background: var(--lp-white);
    color: var(--lp-ink);
    border-radius: var(--lp-radius-panel);
    padding: clamp(24px, 4vw, 44px);
    box-shadow: var(--lp-hero-shadow);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .principles {
    display: flex;
    flex-direction: column;
  }
  .principles li {
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.35;
    font-weight: 600;
    padding: 14px 0;
    border-bottom: 1px solid var(--lp-border);
  }
  .principles li:first-child {
    padding-top: 0;
  }
  .principles strong {
    font-weight: 800;
  }
  .build {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .build strong {
    font-weight: 800;
    color: var(--lp-pink-text);
  }
  .diff-foot {
    font-size: 16px;
    line-height: 1.6;
    color: var(--lp-muted);
  }

  /* 5. Who we help */
  .quotes-wrap {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .quotes-intro,
  .quotes-outro {
    font-size: 18px;
    font-weight: 700;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }
  .quotes li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--lp-surface);
    border-radius: var(--lp-radius-card) var(--lp-radius-card) var(--lp-radius-card) 4px;
    padding: 24px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .quotes :global(svg) {
    color: var(--lp-pink-text);
  }
  .quotes q {
    quotes: '“' '”';
  }

  /* 5b. Client testimonials: two-up on desktop, stacked on mobile. */
  .clients {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .clients-note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--lp-muted);
    text-align: center;
  }

  /* 6. Pricing: "What happens if you need more?" */
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    padding: clamp(22px, 3vw, 32px);
  }
  .more-copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .more h3 {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.3;
  }
  .more p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .more p strong,
  .more .more-strong {
    color: var(--lp-ink);
    font-weight: 800;
  }
  @media (max-width: 559.98px) {
    .more .lp-btn {
      width: 100%;
    }
  }

  /* 7. How it works */
  .how-close {
    font-size: clamp(19px, 2vw, 22px);
    font-weight: 800;
    line-height: 1.4;
    text-align: center;
  }

  /* 8. Free review copy (inside the pink band; white text is large/bold only). */
  .review-title {
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .review-title span {
    display: block;
    margin-top: 6px;
    font-size: 0.62em;
    letter-spacing: -0.02em;
  }
  .review-intro,
  .review-label {
    font-size: 19px;
    line-height: 1.5;
    font-weight: 700;
  }
  .review-label {
    margin-bottom: 12px;
  }
  .review-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 10px 20px;
  }
  .review-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.35;
  }
  .review-list :global(svg) {
    flex: none;
    margin-top: 2px;
  }
  /* Pull-quote on the pink band: a pink rule would be invisible here, so
     the rule is white. */
  .review-quote {
    --quote-rule: var(--lp-white);
  }
  .review-strong {
    font-size: 21px;
