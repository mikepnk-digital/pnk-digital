---
// Tech Support Plans (company voice, cool slate neutrals). Formerly version B
// of the A/B test at /tech-support/service, which now 301s here (CloudFront).
// Positioning: "Your business technology, taken care of."
// Copy: design-assets/copy/pnk-digital-landing-page-copy.md, held in
// src/data/tech-support-service.ts.
// Honesty rule: no team size, years trading, certifications, client counts or
// statistics anywhere – copy, meta or alt text. Exceptions: client
// testimonials, which must use client-approved wording and names (see
// `testimonials` in tech-support-service.ts); the support case study and its
// result (content/case-studies, supplied by Mike); Mike's photo and name in "Why
// PNK Digital"; and the contact details (phone, email, location from
// src/config/site.ts) and statutory company disclosure in the footer.
import LandingLayout from '@/layouts/LandingLayout.astro';
import LandingHeader from '@/components/landing/LandingHeader.astro';
import HeroCompany from '@/components/landing/HeroCompany.astro';
import ServiceGrid from '@/components/landing/ServiceGrid.astro';
import CtaStrip from '@/components/landing/CtaStrip.astro';
import PricingSection from '@/components/landing/PricingSection.astro';
import Steps from '@/components/landing/Steps.astro';
import FaqSection from '@/components/landing/FaqSection.astro';
import BookingBand from '@/components/landing/BookingBand.astro';
import LandingFooter from '@/components/landing/LandingFooter.astro';
import StickyCta from '@/components/landing/StickyCta.astro';
import Testimonial from '@/components/landing/Testimonial.astro';
import ProblemSplit from '@/components/landing/ProblemSplit.astro';
import WhySection from '@/components/landing/WhySection.astro';
import QuoteGrid from '@/components/landing/QuoteGrid.astro';
import ListCard from '@/components/landing/ListCard.astro';
import FinalCta from '@/components/landing/FinalCta.astro';
import BookingCopy from '@/components/landing/BookingCopy.astro';
import CaseStudyCard from '@/components/landing/CaseStudyCard.astro';
import { getCaseStudyFor } from '@/lib/case-studies-collection';
import { faqPageJsonLd, serviceJsonLd } from '@/lib/structured-data';
import { LOCATION, RESPONSE_PROMISE } from '@/config/site';
import {
  PRIMARY_CTA,
  automationItems,
  booking,
  disciplines,
  faqs,
  plans,
  principles,
  problems,
  quotes,
  reviewAreas,
  securityItems,
  services,
  steps,
  testimonials,
} from '@/data/tech-support-service';

const variant = 'b';
const caseStudy = await getCaseStudyFor('support');
const pull = testimonials.find((t) => t.pullQuote)!;
const localItems = [
  `Based in ${LOCATION}`,
  'On-site across Surrey and Hampshire when needed',
  'Remote support across the UK',
];
const TITLE = `IT Support for Small Businesses in ${LOCATION} | PNK Digital`;
const DESCRIPTION =
  'Website, email, Microsoft 365, security, automation and technical support – managed by one experienced technology partner. Book a free 30-minute technology review.';
const CANONICAL = 'https://pnk-digital.com/tech-support';

// FAQPage + Service with one Offer per plan card (monthly; the page doesn't
// state VAT treatment, so the markup doesn't either).
const jsonLd = [
  faqPageJsonLd(faqs),
  serviceJsonLd({
    name: 'Tech Support Plans',
    serviceType: 'IT support',
    description: DESCRIPTION,
    url: CANONICAL,
    pricingAnchor: 'plans',
    plans,
  }),
];
const navLinks = [
  { href: '#clients', label: 'Clients' },
  { href: '#plans', label: 'Plans' },
  { href: '#how', label: 'How it works' },
  { href: '#faq', label: 'FAQ' },
];
---
<LandingLayout
  theme={variant}
  title={TITLE}
  description={DESCRIPTION}
  canonical={CANONICAL}
  ogImage="/og/tech-support.png"
  twitterImage="/og/tech-support.png"
  jsonLd={jsonLd}
>
  <LandingHeader links={navLinks} />

  <main>
    <!-- 1. Hero -->
    <HeroCompany
      sub={`Website, email, Microsoft 365, security, automation and technical support – managed by one experienced technology partner, based in ${LOCATION}.`}
    />

    <!-- 2. Problem -->
    <ProblemSplit
      title="You shouldn't have to be your company's IT department."
      problems={problems}
      answer="We become the person you can call when you need your business technology sorted."
    >
      <p class="lp-lead">As your business grows, so does the technology behind it.</p>
      <p class="lp-lead">
        New employees need accounts. Your website needs updating. Email stops working. Someone needs to manage your
        domains. Security needs attention. And suddenly, you're spending your time figuring out technology instead of
        running your business.
      </p>
    </ProblemSplit>

    <!-- 3. Proposition / services -->
    <section id="services" class="lp-section lp-section--surface" aria-labelledby="services-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">What we look after</span>
          <h2 id="services-title" class="lp-h2">One partner for your business technology.</h2>
          <p class="lp-lead">
            Instead of managing a collection of suppliers, accounts and technical problems, you get one experienced partner
            who understands how everything fits together.
          </p>
        </div>
        <ServiceGrid items={services} iconStyle="solid" columns={3} />
        <CtaStrip
          text="One person. One point of contact. One place to go when technology gets in the way."
          tone="card"
          cta={PRIMARY_CTA}
        />
      </div>
    </section>

    <!-- 4. Differentiator -->
    <WhySection
      title="More than IT support."
      lead="PNK Digital isn't a traditional IT helpdesk."
      disciplines={disciplines}
      principles={principles}
      foot="From a website problem to a custom business application, you have one technical partner who can help you find the right solution."
    >
      <p>
        We're software engineers and technology specialists who understand both{' '}<strong>how businesses use technology</strong> and <strong>how to build it</strong>. That means we're not limited to fixing what's broken.
      </p>
      <Fragment slot="build">And if your business needs something that doesn't exist yet, <strong>we can build it.</strong></Fragment>
    </WhySection>

    <!-- 5. Who we help -->
    <section class="lp-section" aria-labelledby="who-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Who we help</span>
          <h2 id="who-title" class="lp-h2">Built for businesses that have outgrown doing it themselves.</h2>
          <p class="lp-lead">
            PNK Digital is designed for small and growing businesses that need reliable technology support but aren't ready –
            or don't want – to employ a full-time IT team.
          </p>
          <p class="lp-lead">
            Typically, that's a business with around <strong class="lp-ink lp-nowrap">5–50 people</strong> that has reached the point where
            technology is too important to leave to chance, but doesn't need a full internal IT department.
          </p>
        </div>
        <QuoteGrid
          quotes={quotes}
          intro="If you're currently relying on:"
          outro="…it might be time to have someone properly looking after it."
        />
      </div>
    </section>

    <!-- 6. Security -->
    <section class="lp-section lp-section--surface" aria-labelledby="sec-title">
      <div class="lp-container lp-split">
        <div class="lp-intro">
          <span class="lp-eyebrow">Security</span>
          <h2 id="sec-title" class="lp-h2">Technology should make your business safer – not create another risk.</h2>
          <p class="lp-lead">
            Your business relies on email, cloud applications, websites and online accounts every day. We'll help make sure the
            basics are properly looked after.
          </p>
          <p class="lp-lead">We don't believe in selling unnecessary technology.</p>
          <p class="lp-statement">We'll focus on the things that genuinely reduce risk for your business.</p>
        </div>
        <ListCard icon="shield-check" title="That can include:" items={securityItems} />
      </div>
    </section>

    <!-- 7. Client testimonials -->
    <section id="clients" class="lp-section" aria-labelledby="clients-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">Client stories</span>
          <h2 id="clients-title" class="lp-h2">Businesses that stopped worrying about their technology.</h2>
          <p class="lp-lead">A few words from businesses PNK Digital looks after today.</p>
        </div>
        <ul class="clients" data-reveal-stagger>
          {
            testimonials.map((t) => (
              <li>
                <Testimonial quote={t.quote} name={t.name} role={t.role} company={t.company} services={t.services} />
              </li>
            ))
          }
        </ul>
        {caseStudy && <CaseStudyCard study={caseStudy} />}
        <p class="clients-note" data-reveal>Want to hear more? Ask us about current clients on your free technology review.</p>
      </div>
    </section>

    <!-- 8. Pricing -->
    <PricingSection
      eyebrow="Pricing"
      title="Simple monthly support. No surprise bills."
      lead="Choose the level of support that's right for your business. If you're not sure, we'll help you work it out."
      plans={plans}
      highlight="business"
      badge="Recommended"
      cardCta={PRIMARY_CTA}
      cardConfirm=""
    >
      <div class="more" data-reveal>
        <div class="more-copy">
          <h3>What happens if you need more?</h3>
          <p>
            Each plan includes an agreed amount of hands-on work. If something needs more than that, a larger project or work
            outside your plan, we'll tell you <strong>before we do it</strong> and quote it as a fixed price. Plan clients get
            10% off project work.
          </p>
          <p class="more-strong">No unexpected invoices.</p>
        </div>
        <a class="lp-btn lp-btn--pink" href="#book" data-book>{PRIMARY_CTA}</a>
      </div>
    </PricingSection>

    <!-- 9. How it works -->
    <section id="how" class="lp-section" aria-labelledby="how-title">
      <div class="lp-container lp-stack">
        <div class="lp-intro">
          <span class="lp-eyebrow">How it works</span>
          <h2 id="how-title" class="lp-h2">Getting started is simple.</h2>
        </div>
        <Steps steps={steps} />
        <p class="how-close" data-reveal>You get on with running the business. We'll look after the technology.</p>
      </div>
    </section>

    <!-- 10. Free technology review (booking form) -->
    <BookingBand
      variant={variant}
      calendar
      successLine={booking.successLine}
      form={{
        compact: true,
        messageLabel: 'What do you need help with?',
        messagePlaceholder: 'e.g. Nobody is sure who manages our domain, and new starters take days to set up',
        reassurance: `No obligation. No hard sell. We'll reply ${RESPONSE_PROMISE}.`,
      }}
    >
      <BookingCopy
        slot="copy"
        title="Not sure what you actually need?"
        intro="Book a free 30-minute technology review and we'll talk through the technology your business relies on."
        outro="You'll leave with a clearer picture of what's working, what needs attention and where you could improve."
        areas={reviewAreas}
        pull={pull}
      />
    </BookingBand>

    <!-- 11. Automation & AI -->
    <section class="lp-section lp-section--surface" aria-labelledby="auto-title">
      <div class="lp-container lp-split">
        <div class="lp-intro">
          <span class="lp-eyebrow">Automation &amp; AI</span>
          <h2 id="auto-title" class="lp-h2">Spend less time doing work a computer could do for you.</h2>
          <p class="lp-lead">
            Not every business needs an AI chatbot. But almost every business has repetitive tasks that could be made simpler.
          </p>
          <p class="lp-statement">The goal isn't to add more technology.</p>
          <p class="lp-lead">It's to give your team more time to do the work that actually matters.</p>
          <p class="lp-lead"><a href="/ai-consulting">Want AI built into a process, not just talked about? See AI consulting →</a></p>
        </div>
        <ListCard icon="zap" title="We'll look at how your team works and find ways to:" items={automationItems} />
      </div>
    </section>

    <!-- 12. Local to you -->
    <section class="lp-section" aria-labelledby="local-title">
      <div class="lp-container lp-split">
        <div class="lp-intro">
          <span class="lp-eyebrow">Local to you</span>
          <h2 id="local-title" class="lp-h2">Based in {LOCATION.split(',')[0]}. Supporting businesses across the UK.</h2>
          <p class="lp-lead">
            Most technical issues can be resolved remotely, wherever your business is. When something needs someone on
            site, we'll come to you.
          </p>
        </div>
        <ListCard icon="globe" title="Where we work:" items={localItems} />
      </div>
    </section>

    <!-- 13. FAQ -->
    <FaqSection
      title="Frequently asked questions"
      lead="Anything else? Ask us on your free technology review."
      items={faqs}
      surface
    />

    <!-- 14. Final CTA -->
    <FinalCta title="Stop worrying about your technology." cta={PRIMARY_CTA}>
      <p class="final-lead">
        Your business is too important to leave your technology to whoever happens to have the password.
      </p>
      <p class="final-lead">
        Get one experienced technology partner who can <strong>support it, secure it, improve it and build it.</strong>
      </p>
    </FinalCta>
  </main>

  <LandingFooter />
  <StickyCta />
</LandingLayout>

<style>
  /* 7. Client testimonials: two-up on desktop, stacked on mobile. */
  .clients {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .clients-note {
    font-size: var(--lp-text-sm);
    line-height: 1.6;
    color: var(--lp-muted);
    text-align: center;
  }

  /* 8. Pricing: "What happens if you need more?" */
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--lp-white);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-card);
    padding: clamp(22px, 3vw, 32px);
  }
  .more-copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .more h3 {
    font-size: var(--lp-h3);
    font-weight: 800;
    line-height: 1.3;
  }
  .more p {
    font-size: var(--lp-text-base);
    line-height: 1.6;
    color: var(--lp-muted);
  }
  .more p strong,
  .more .more-strong {
    color: var(--lp-ink);
    font-weight: 800;
  }
  @media (max-width: 559.98px) {
    .more .lp-btn {
      width: 100%;
    }
  }

  /* 9. How it works */
  .how-close {
    font-size: clamp(19px, 2vw, 22px);
    font-weight: 800;
    line-height: 1.4;
    text-align: center;
  }
</style>
